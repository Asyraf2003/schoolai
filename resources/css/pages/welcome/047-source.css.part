}

.social-video-cover--facebook {
    background:
        radial-gradient(
            circle at 22% 18%,
            rgba(255, 255, 255, 0.22),
            transparent 30%
        ),
        linear-gradient(135deg, #1877f2, #0d47a1);
}

.social-video-cover--tiktok {
    background:
        radial-gradient(
            circle at 20% 18%,
            rgba(37, 244, 238, 0.32),
            transparent 32%
        ),
        radial-gradient(
            circle at 82% 80%,
            rgba(254, 44, 85, 0.32),
            transparent 36%
        ),
        linear-gradient(135deg, #111827, #020617);
}

.social-video-cover--vimeo {
    background:
        radial-gradient(
            circle at 22% 18%,
            rgba(255, 255, 255, 0.22),
            transparent 30%
        ),
        linear-gradient(135deg, #1ab7ea, #087ba5);
}

.gallery-wall-card__play.social-video-cover__play,
.galeri-story-card__mobile-play.social-video-cover__play,
.galeri-story-visual__play.social-video-cover__play {
    inset: auto 16px 16px auto;
    transform: none;
    width: 46px;
    height: 46px;
    background: rgba(255, 255, 255, 0.94);
    color: #111827;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.24);
}

@media (max-width: 560px) {
    .social-video-cover {
        padding: 18px;
    }

    .social-video-cover__logo {
        width: 58px;
        height: 58px;
        border-radius: 16px;
    }

    .social-video-cover__brand {
        font-size: 1.2rem;
    }

    .gallery-wall-card__play.social-video-cover__play,
    .galeri-story-card__mobile-play.social-video-cover__play,
    .galeri-story-visual__play.social-video-cover__play {
        right: 12px;
        bottom: 12px;
        width: 42px;
        height: 42px;
    }
}
