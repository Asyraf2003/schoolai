.galeri-story__visual {
    position: sticky;
    top: calc(var(--nav-h) + 110px);
    min-height: calc(100svh - var(--nav-h) - 150px);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(var(--gallery-visual-shift-x));
}

.galeri-story-visual__track {
    position: relative;
    width: min(100%, 500px);
    aspect-ratio: 1.28 / 1;
}

.galeri-story-visual__panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(18px) scale(0.965);
    filter: blur(8px);
    pointer-events: none;
    transition:
        opacity 0.6s ease,
        transform 0.6s ease,
        filter 0.6s ease;
}

.galeri-story-visual__panel.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
}

.galeri-story-visual__media {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 30px;
    background:
        radial-gradient(
            circle at 18% 12%,
            rgba(255, 255, 255, 0.48),
            transparent 30%
        ),
        linear-gradient(135deg, var(--g1), var(--g2));
    border: 1px solid rgba(31, 46, 43, 0.07);
    box-shadow:
        0 26px 62px rgba(31, 46, 43, 0.14),
        0 2px 0 rgba(255, 255, 255, 0.65) inset;
}

.galeri-story-visual__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.galeri-story-visual__fallback {
    display: grid;
    place-items: center;
    width: clamp(104px, 10vw, 146px);
    height: clamp(104px, 10vw, 146px);
    border-radius: 34px;
    background: rgba(255, 255, 255, 0.24);
    color: #ffffff;
    font-size: clamp(3.35rem, 4.7vw, 4.9rem);
    box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.32),
        0 18px 42px rgba(18, 18, 24, 0.12);
}

.galeri-story-visual__badge {
    position: absolute;
    top: 18px;
    left: 18px;
    display: inline-flex;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 900;
    box-shadow: 0 10px 24px rgba(18, 18, 24, 0.12);
}

.galeri-story-visual__play {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: var(--gallery-accent);
    font-size: 0.98rem;
    font-weight: 900;
    box-shadow: 0 14px 30px rgba(18, 18, 24, 0.16);
}

.galeri-story-visual__body,
.galeri-story-visual__meta {
    display: none !important;
}

.galeri-section__action {
    position: relative;
    z-index: 2;
    margin-top: 0;
    text-align: center;
}

.galeri-section .btn--white {
    background: var(--color-ink);
    color: #ffffff;
    border-color: var(--color-ink);
    box-shadow: 0 16px 36px rgba(31, 46, 43, 0.16);
}

.galeri-section .btn--white:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 48px rgba(31, 46, 43, 0.2);
}

@media (max-width: 1024px) {
    .galeri-section .section-head {
        margin-bottom: 40px;
    }

    .galeri-story {
        grid-template-columns: 1fr;
        max-width: 640px;

        /* EDIT DI SINI MOBILE: jangan geser gambar di tablet/HP. */
        --gallery-story-gap: 30px;
        --gallery-visual-shift-x: 0px;

        gap: var(--gallery-story-gap);
    }

    .galeri-story::before {
        display: none;
    }

    .galeri-story__visual {
        position: relative;
        top: auto;
        min-height: auto;
        justify-content: center;
        order: 1;
    }

    .galeri-story__copy {
        order: 2;
        max-width: none;
        padding-block: 0;
    }

    .galeri-story-card {
        min-height: auto;
        padding: 28px 0;
        opacity: 1;
        transform: none;
    }

    .galeri-story-visual__track {
        width: min(100%, 500px);
    }
}

@media (max-width: 720px) {
    .galeri-section .section-title--white {
        font-size: clamp(2.15rem, 10vw, 3.3rem);
    }
