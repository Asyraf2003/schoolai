    font-size: clamp(1.85rem, 3.2vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--color-ink);
}

.gallery-wall-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(12px, 1.6vw, 20px);
}

.gallery-wall-card {
    position: relative;
    min-height: 270px;
    border-radius: clamp(22px, 2.4vw, 34px);
    overflow: hidden;
    background: linear-gradient(135deg, var(--gallery-g1), var(--gallery-g2));
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition:
        transform 0.24s ease,
        box-shadow 0.24s ease,
        filter 0.24s ease;
}

.gallery-wall-card:nth-child(9n + 1),
.gallery-wall-card:nth-child(9n + 7) {
    grid-column: span 2;
}

.gallery-wall-card:nth-child(9n + 3) {
    grid-row: span 2;
    min-height: 560px;
}

.gallery-wall-card:nth-child(9n + 5) {
    min-height: 340px;
}

.gallery-wall-card:hover,
.gallery-wall-card:focus-visible {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card);
    filter: saturate(1.04);
    outline: none;
}

.gallery-wall-card__media {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
}

.gallery-wall-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg, transparent 26%, rgba(31, 30, 46, 0.64)),
        radial-gradient(
            circle at 18% 14%,
            rgba(255, 255, 255, 0.28),
            transparent 22%
        );
}

.gallery-wall-card__media img,
.gallery-wall-card__media iframe {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    display: block;
    background: #111827;
    pointer-events: none;
}

.gallery-wall-card__media span {
    position: relative;
    z-index: 1;
    font-size: clamp(3.2rem, 6vw, 6.5rem);
    filter: drop-shadow(0 16px 22px rgba(31, 30, 46, 0.18));
}

.gallery-wall-card__caption {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: grid;
    gap: 9px;
    color: var(--color-white);
}

.gallery-wall-card__caption span {
    width: fit-content;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.75rem;
    font-weight: 950;
    backdrop-filter: blur(10px);
}

.gallery-wall-card__caption h3 {
    max-width: 92%;
    font-family: var(--font-display);
    font-size: clamp(1.16rem, 1.6vw, 1.9rem);
    line-height: 1.05;
    color: var(--color-white);
    text-shadow: 0 12px 28px rgba(0, 0, 0, 0.24);
}

.gallery-wall-lightbox[hidden] {
    display: none;
}

.gallery-wall-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 10px;
}

.gallery-wall-lightbox__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(31, 30, 46, 0.74);
    backdrop-filter: blur(8px);
}

.gallery-wall-lightbox__panel {
    position: relative;
    width: fit-content;
    max-width: 100%;
    max-height: calc(100dvh - 20px);
    overflow: visible;
    padding: 9px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 27px;
    background: var(--color-white);
    box-shadow: var(--shadow-float);
}

.gallery-wall-lightbox__close {
    position: absolute;
    right: 17px;
    top: 17px;
    z-index: 4;
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-white);
    font-weight: 900;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
}

.gallery-wall-lightbox__media {
    display: grid;
    place-items: center;
    width: min(960px, calc(100vw - 38px));
    min-width: 0;
    min-height: 0;
    border-radius: 19px;
    background: #111827;
    overflow: hidden;
}

.gallery-wall-lightbox__media.is-landscape {
    width: min(960px, calc(100vw - 38px), calc(177.78dvh - 68px));
    aspect-ratio: 16 / 9;
}
