.galeri-section {
    position: relative;
    overflow: clip;
    background:
        radial-gradient(
            circle at 8% 18%,
            rgba(255, 224, 130, 0.22),
            transparent 28%
        ),
        radial-gradient(
            circle at 92% 12%,
            rgba(34, 197, 94, 0.12),
            transparent 25%
        ),
        linear-gradient(180deg, #fffef8 0%, #ffffff 46%, #fffaf0 100%);
    color: var(--color-ink);
}

.galeri-section::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 120px;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(255, 250, 240, 0.92));
}

.galeri-section > .container {
    position: relative;
    z-index: 1;
}

.galeri-section .section-head {
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: clamp(54px, 7vw, 92px);
    text-align: center;
}

.galeri-section .section-title--white {
    color: var(--color-ink);
    font-size: clamp(2.5rem, 4vw + 1rem, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
}

.galeri-section .section-subtitle--white {
    max-width: 760px;
    margin-inline: auto;
    color: rgba(31, 46, 43, 0.72);
    font-size: clamp(1rem, 0.45vw + 0.92rem, 1.18rem);
    line-height: 1.72;
}

.galeri-story {
    position: relative;
    max-width: 1120px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(280px, 430px) minmax(320px, 500px);

    /* EDIT DI SINI: jarak antara teks kiri dan gambar kanan. */
    --gallery-story-gap: clamp(58px, 9vw, 146px);

    /* EDIT DI SINI: geser gambar kanan. 2cm sesuai request, bisa ganti ke 1cm, 60px, 80px, dst. */
    --gallery-visual-shift-x: 2cm;

    gap: var(--gallery-story-gap);
    align-items: start;
}

.galeri-story::before {
    content: "";
    position: absolute;
    top: 2vh;
    bottom: 10vh;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: linear-gradient(
        180deg,
        transparent,
        rgba(31, 46, 43, 0.16) 12%,
        rgba(31, 46, 43, 0.22) 50%,
        rgba(31, 46, 43, 0.16) 88%,
        transparent
    );
}

.galeri-story__copy {
    max-width: 430px;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-block: 10vh 14vh;
}

.galeri-story-card {
    min-height: 68vh;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    opacity: 0.28;
    transform: translateY(18px);
    transition:
        opacity 0.48s ease,
        transform 0.48s ease,
        filter 0.48s ease;
    filter: blur(0.2px);
}

.galeri-story-card.is-active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
}

.galeri-story-card__number {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: #eef7d6;
    color: #496220;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 900;
    box-shadow: inset 0 0 0 1px rgba(73, 98, 32, 0.08);
}

.galeri-story-card__content {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.galeri-story-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.galeri-story-card__meta span {
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: rgba(31, 46, 43, 0.56);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

.galeri-story-card h3 {
    max-width: 430px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.45vw + 1.05rem, 2.65rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
}

.galeri-story-card p {
    max-width: 410px;
    color: rgba(31, 46, 43, 0.74);
    font-size: clamp(0.96rem, 0.25vw + 0.9rem, 1.08rem);
    line-height: 1.72;
}

.galeri-story-card__link,
.galeri-story-card__link--disabled {
    display: none !important;
}

