    }
}

/* Lokasi pakai maps.png, Facebook aktif, semua channel tetap satu UI lazy asset. */
.footer-location-line {
    display: none;
}

.footer-channel--maps {
    --channel-accent: #34a853;
}

.footer-channel-grid {
    max-width: 340px;
}

.footer-channel-grid .footer-channel:last-child:nth-child(odd) {
    grid-column: 1 / -1;
}

.footer-channel__asset {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    display: block;
    object-fit: contain;
    transform: translateZ(0);
    transition:
        transform 0.22s ease,
        filter 0.22s ease,
        opacity 0.22s ease;
}

.footer-channel:hover .footer-channel__asset,
.footer-channel:focus-visible .footer-channel__asset {
    transform: translateY(-1px) scale(1.08) rotate(-3deg);
}

.footer-channel__fallback {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(31, 46, 43, 0.08);
    color: #444;
    font-size: 0.7rem;
    font-weight: 950;
}

@media (max-width: 560px) {
    .footer-channel-grid {
        max-width: none;
    }

    .footer-channel__asset,
    .footer-channel__fallback {
        width: 26px;
        height: 26px;
        flex-basis: 26px;
    }
}

/* Deskripsi singkat di bawah logo footer agar kolom brand tidak terasa kosong. */
.footer-brand__description {
    max-width: 300px;
    margin: -10px 0 22px;
    color: #666;
    font-size: 0.9rem;
    line-height: 1.7;
}

@media (max-width: 560px) {
    .footer-brand__description {
        max-width: none;
        margin-bottom: 20px;
        font-size: 0.88rem;
    }
}

/* Urutan footer: Logo Sekolah | Media Sosial | Halaman Kami | Galeri Kami | Mitra Kami. */
.site-footer__grid {
    grid-template-columns:
        minmax(170px, 0.9fr)
        minmax(260px, 1.25fr)
        minmax(130px, 0.7fr)
        minmax(150px, 0.78fr)
        minmax(250px, 1fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: start;
}

.footer-brand,
.footer-channels,
.footer-links,
.footer-gallery-links,
.footer-partners {
    min-width: 0;
}

.footer-channels .footer-channel-group {
    margin-top: 0;
}

.footer-channels .footer-channel-group > strong {
    display: block;
    margin: 0 0 22px;
    color: #1f1f1f;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 950;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.footer-channels .footer-channel-grid {
    max-width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.footer-channels .footer-channel {
    min-height: 58px;
    padding: 10px;
}

.footer-channels .footer-channel__label {
    font-size: 0.82rem;
}

.footer-channels .footer-channel__note {
    font-size: 0.68rem;
}

@media (max-width: 1180px) {
    .site-footer__grid {
        grid-template-columns: minmax(190px, 1fr) minmax(260px, 1.2fr) minmax(
                150px,
                0.8fr
            );
    }

    .footer-brand {
        grid-column: 1 / 2;
    }

    .footer-channels {
        grid-column: 2 / 3;
    }

    .footer-links {
        grid-column: 3 / 4;
    }

    .footer-gallery-links {
        grid-column: 1 / 2;
    }

    .footer-partners {
        grid-column: 2 / -1;
    }
}

@media (max-width: 820px) {
    .site-footer__grid {
        grid-template-columns: 1fr 1fr;
    }

    .footer-brand,
    .footer-channels,
    .footer-partners {
        grid-column: 1 / -1;
    }

    .footer-links {
        grid-column: 1 / 2;
    }

    .footer-gallery-links {
