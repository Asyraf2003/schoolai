    transform: rotate(-1deg);
}

.nilai-mark--green {
    --nilai-mark-color: #15803d;
    --nilai-mark-bg: rgba(34, 197, 94, 0.18);
}

.nilai-mark--orange {
    --nilai-mark-color: #c2410c;
    --nilai-mark-bg: rgba(249, 115, 22, 0.18);
}

.nilai-mark--blue {
    --nilai-mark-color: #0369a1;
    --nilai-mark-bg: rgba(14, 165, 233, 0.18);
}

.nilai-mark--purple {
    --nilai-mark-color: #7e22ce;
    --nilai-mark-bg: rgba(168, 85, 247, 0.16);
}

.nilai-card.is-active {
    transform: translateY(-9px) rotate(-0.6deg);
    border-color: color-mix(in srgb, var(--nilai-accent) 42%, transparent);
    background: linear-gradient(
        145deg,
        rgba(255, 255, 255, 1),
        color-mix(in srgb, var(--nilai-accent) 10%, #fffaf0)
    );
    box-shadow:
        0 30px 70px rgba(33, 31, 59, 0.14),
        0 0 0 1px color-mix(in srgb, var(--nilai-accent) 12%, transparent);
}

.nilai-card.is-active::before {
    transform: scaleX(1);
    opacity: 1;
}

.nilai-card.is-active::after {
    opacity: 0.18;
    transform: translate(-22px, 28px) scale(1.12);
}

.nilai-card.is-active .nilai-card__glow {
    opacity: 1;
}

.nilai-card.is-active .nilai-card__code {
    background: var(--nilai-accent);
    color: #fff;
    transform: rotate(-6deg) scale(1.08);
    box-shadow:
        0 18px 34px color-mix(in srgb, var(--nilai-accent) 24%, transparent),
        inset 0 0 0 1px rgba(255, 255, 255, 0.26);
}

.nilai-card.is-active .nilai-card__spark {
    opacity: 0.9;
    transform: rotate(45deg) scale(1.12);
}

.nilai-card.is-active .nilai-card__title {
    color: var(--nilai-accent);
}

@media (hover: hover) and (pointer: fine) {
    .nilai-card:hover,
    .nilai-card:focus-visible {
        transform: translateY(-10px) rotate(-0.8deg);
        border-color: color-mix(in srgb, var(--nilai-accent) 44%, transparent);
        box-shadow:
            0 32px 76px rgba(33, 31, 59, 0.15),
            0 0 0 1px color-mix(in srgb, var(--nilai-accent) 12%, transparent);
        outline: none;
    }

    .nilai-card:hover::before,
    .nilai-card:focus-visible::before {
        transform: scaleX(1);
        opacity: 1;
    }

    .nilai-card:hover .nilai-card__glow,
    .nilai-card:focus-visible .nilai-card__glow {
        opacity: 1;
    }

    .nilai-card:hover .nilai-card__code,
    .nilai-card:focus-visible .nilai-card__code {
        background: var(--nilai-accent);
        color: #fff;
        transform: rotate(-6deg) scale(1.08);
    }

    .nilai-card:hover .nilai-card__spark,
    .nilai-card:focus-visible .nilai-card__spark {
        opacity: 0.9;
        transform: rotate(45deg) scale(1.12);
    }

    .nilai-card:hover .nilai-card__title,
    .nilai-card:focus-visible .nilai-card__title {
        color: var(--nilai-accent);
    }
}

@media (max-width: 1100px) {
    .nilai-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 767px) {
    .nilai-section__intro {
        margin-bottom: 24px;
    }

    .nilai-grid {
        grid-template-columns: 1fr;
        gap: 16px;
        margin-bottom: 64px;
    }

    .nilai-card {
        min-height: auto;
        padding: 20px;
        border-radius: 24px;
    }

    .nilai-card__code {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        font-size: 1.62rem;
    }

    .nilai-card__spark {
        width: 28px;
        height: 28px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .nilai-card,
    .nilai-card::before,
    .nilai-card::after,
    .nilai-card__glow,
    .nilai-card__code,
    .nilai-card__spark {
        transition: none !important;
    }
}

.program-section {
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(
            circle at 10% 12%,
            rgba(249, 115, 22, 0.14),
            transparent 30%
        ),
        radial-gradient(
            circle at 88% 20%,
            rgba(14, 165, 233, 0.13),
            transparent 34%
        ),
        linear-gradient(180deg, #f8fff8 0%, #fffaf0 100%);
}

.program-section::before,
.program-section::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(2px);
