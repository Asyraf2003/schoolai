.program-card.is-active::before {
    transform: scaleX(1);
    opacity: 1;
}

.program-card.is-active::after {
    opacity: 0.18;
    transform: translate(-26px, 30px) scale(1.15);
}

.program-card.is-active .program-card__orb {
    opacity: 1;
}

.program-card.is-active .program-card__code {
    background: var(--program-accent);
    color: #fff;
    transform: rotate(-6deg) scale(1.08);
}

.program-card.is-active .program-card__title {
    color: var(--program-accent);
}

.program-card.is-active .program-card__footer {
    opacity: 1;
    transform: translateX(3px);
}

.program-empty {
    grid-column: 1 / -1;
    padding: 28px;
    border-radius: 24px;
    background: #fff;
    color: var(--color-ink-soft);
    font-weight: 800;
    text-align: center;
}

@media (hover: hover) and (pointer: fine) {
    .program-card:hover,
    .program-card:focus-visible {
        transform: translateY(-9px) rotate(-0.5deg);
        border-color: color-mix(
            in srgb,
            var(--program-accent) 44%,
            transparent
        );
        box-shadow:
            0 32px 76px rgba(33, 31, 59, 0.15),
            0 0 0 1px color-mix(in srgb, var(--program-accent) 12%, transparent);
        outline: none;
    }

    .program-card:hover::before,
    .program-card:focus-visible::before {
        transform: scaleX(1);
        opacity: 1;
    }

    .program-card:hover::after,
    .program-card:focus-visible::after {
        opacity: 0.18;
        transform: translate(-26px, 30px) scale(1.15);
    }

    .program-card:hover .program-card__orb,
    .program-card:focus-visible .program-card__orb {
        opacity: 1;
    }

    .program-card:hover .program-card__code,
    .program-card:focus-visible .program-card__code {
        background: var(--program-accent);
        color: #fff;
        transform: rotate(-6deg) scale(1.08);
    }

    .program-card:hover .program-card__title,
    .program-card:focus-visible .program-card__title {
        color: var(--program-accent);
    }

    .program-card:hover .program-card__footer,
    .program-card:focus-visible .program-card__footer {
        opacity: 1;
        transform: translateX(3px);
    }
}

@media (max-width: 1100px) {
    .program-section__shell {
        grid-template-columns: 1fr;
    }

    .program-spotlight {
        position: relative;
        top: auto;
    }
}

@media (max-width: 760px) {
    .program-section__shell {
        gap: 22px;
    }

    .program-spotlight {
        padding: 28px 22px;
        border-radius: 28px;
    }

    .program-flow {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .program-card {
        min-height: auto;
        padding: 20px;
        border-radius: 24px;
    }

    .program-card__code {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        font-size: 1.15rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    .program-spotlight::before {
        animation: none !important;
    }

    .program-card,
    .program-card::before,
    .program-card::after,
    .program-card__orb,
    .program-card__code,
    .program-card__footer {
        transition: none !important;
    }
}

@keyframes program-orbit {
    to {
        transform: rotate(360deg);
    }
}

/* GALLERY_TEASER_DATA_READY_LOCAL */
.galeri-grid--teaser {
    columns: auto;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
}

.galeri-card {
    min-height: 320px;
    height: auto;
    break-inside: auto;
    margin-bottom: 0;
    align-items: stretch;
    justify-content: flex-start;
    text-align: left;
    background:
        radial-gradient(
            circle at 18% 12%,
            rgba(255, 255, 255, 0.42),
            transparent 32%
        ),
        linear-gradient(135deg, var(--g1), var(--g2));
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 18px 44px rgba(18, 18, 24, 0.22);
}

.galeri-card--normal {
    grid-column: span 2;
