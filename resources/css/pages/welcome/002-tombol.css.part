}
.section-subtitle--white {
    color: rgba(255, 255, 255, 0.85);
}

.text-highlight {
    position: relative;
    color: #c25e1e;
    white-space: nowrap;
}
.text-highlight::after {
    content: "";
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 6%;
    height: 0.35em;
    background: var(--color-yellow);
    opacity: 0.55;
    z-index: -1;
    border-radius: var(--radius-pill);
}

/* Tombol */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.98rem;
    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease;
    white-space: nowrap;
}
.btn--lg {
    padding: 16px 32px;
    font-size: 1.02rem;
}
.btn--primary {
    background: #b84f12;
    color: var(--color-white);
    border: 1px solid #8f3b0d;
    box-shadow: 0 10px 24px rgba(184, 79, 18, 0.3);
}
.btn--primary:hover {
    background: #9e3f0d;
    border-color: #7e320a;
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(158, 63, 13, 0.36);
}
.btn--ghost {
    background: var(--color-white);
    color: var(--color-ink);
    border: 2px solid var(--color-cream-dark);
}
.btn--ghost:hover {
    transform: translateY(-3px);
    border-color: var(--color-orange);
    box-shadow: var(--shadow-soft);
}
.btn--white {
    background: var(--color-white);
    color: #c25e1e;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
}
.btn--white:hover {
    transform: translateY(-3px);
}

.link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    color: #c25e1e;
    transition: gap 0.2s ease;
}
.link-arrow:hover {
    gap: 8px;
}

/* Skip link aksesibilitas */
.skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--color-ink);
    color: var(--color-white);
    padding: 12px 20px;
    z-index: 999;
    border-radius: 0 0 10px 0;
}
.skip-link:focus {
    left: 0;
}

:focus-visible {
    outline: 3px solid var(--color-orange);
    outline-offset: 3px;
}

.navbar__inner,
.navbar__menu,
.navbar__menu ul,
.hero__inner,
.hero__content,
.public-main,
.public-hero__grid,
.ppdb-info-grid,
.featured-article,
.galeri-story,
.artikel-digest,
.site-footer__grid {
    min-width: 0;
}

/* ---------- 4. NAVBAR ---------- */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    z-index: 200;
    background: transparent;
    transition:
        background 0.3s ease,
        box-shadow 0.3s ease,
        height 0.3s ease;
}
.navbar.is-scrolled {
    background: rgba(255, 248, 236, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-soft);
    height: 72px;
}
.navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}
.navbar__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--color-ink);
    line-height: 1.1;
}
.navbar__logo-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    background: var(--color-yellow-soft);
    border-radius: var(--radius-md);
    border: 2px dashed var(--color-yellow);
}
.navbar__logo-text small {
    font-weight: 600;
    color: var(--color-ink-soft);
    font-size: 0.75rem;
}

.navbar__menu {
    display: flex;
    align-items: center;
    gap: 32px;
