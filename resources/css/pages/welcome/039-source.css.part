        opacity: 0.22;
        transform: translateY(0);
    }

    50% {
        opacity: 1;
        transform: translateY(-8px);
    }
}

.ppdb-step-num-box {
    position: relative;
    width: 142px;
    height: 142px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
}

.ppdb-step-num-box::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid rgba(31, 33, 71, 0.04);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.48);
    box-shadow: 0 20px 48px rgba(31, 33, 71, 0.07);
    animation: ppdb-circle-breathe 3s ease-in-out infinite;
}

@keyframes ppdb-circle-breathe {
    0%,
    100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.06);
    }
}

.ppdb-step-icon {
    position: relative;
    z-index: 2;
    width: 62px;
    height: 62px;
    display: grid;
    place-items: center;
    border-radius: 22px;
    color: #1f2147;
    font-size: 1.85rem;
}

.ppdb-step-icon span {
    display: inline-block;
    animation: ppdb-icon-float 2.8s ease-in-out infinite;
}

@keyframes ppdb-icon-float {
    0%,
    100% {
        transform: translateY(0) rotate(-2deg);
    }
    50% {
        transform: translateY(-8px) rotate(4deg);
    }
}

.ppdb-step-num {
    position: absolute;
    right: 4px;
    top: 4px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 18px;
    background: #ffffff;
    color: #19c7e8;
    font-family: var(--font-display);
    font-weight: 900;
    box-shadow: 0 14px 30px rgba(25, 199, 232, 0.22);
}

.ppdb-step-desc h3 {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.3vw, 2rem);
    color: #1f2147;
    letter-spacing: 0.06em;
}

.ppdb-step-desc p {
    max-width: 340px;
    margin: 10px auto 0;
    color: var(--color-ink-soft);
}

.ppdb-step-desc strong {
    display: inline-flex;
    margin-top: 14px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: rgba(25, 199, 232, 0.1);
    color: #0783ad;
    font-weight: 900;
}

.ppdb-journey-cta {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 16px;
    max-width: 780px;
    margin: 24px auto 0;
    text-align: center;
}

.ppdb-journey-cta p {
    color: #1f2147;
    font-weight: 700;
    letter-spacing: 0.06em;
}

@media (max-width: 1100px) {
    .ppdb-flight-stage,
    .ppdb-box-loader {
        display: none;
    }

    .ppdb-work-grid {
        margin-top: 34px;
    }
}

@media (max-width: 900px) {
    .ppdb-work-grid {
        grid-template-columns: 1fr;
        gap: 18px;
    }

    .ppdb-work-process {
        min-height: auto;
        padding: 24px;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.78);
        box-shadow: var(--shadow-soft);
    }
}

@media (max-width: 767px) {
    .ppdb-journey-section {
        padding: 62px 0;
    }

    .ppdb-journey-head h2 {
        letter-spacing: 0;
    }

    .ppdb-journey-kicker {
        letter-spacing: 0.12em;
    }
}

@media (prefers-reduced-motion: reduce) {
    .ppdb-title-effect .bar,
    .ppdb-flight-path,
    .ppdb-flight-plane,
    .ppdb-box-loader span,
    .ppdb-step-num-box::before,
    .ppdb-step-icon span {
        animation: none !important;
    }

    .ppdb-flight-plane {
        opacity: 1;
        transform: translate(430px, 48px) rotate(4deg) scale(1);
    }
}

