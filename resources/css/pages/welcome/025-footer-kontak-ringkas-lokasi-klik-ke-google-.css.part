.footer-partner-card__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: 118px;
    max-height: 48px;
    object-fit: contain;
}

.site-footer__bottom {
    position: relative;
    z-index: 1;
    padding: 22px 0 20px;
    color: #444;
    font-size: 0.9rem;
    text-align: center;
}

.site-footer__bottom strong {
    font-weight: 900;
}

@media (max-width: 1024px) {
    .site-footer__grid {
        grid-template-columns: minmax(280px, 1.2fr) minmax(150px, 0.8fr) minmax(
                220px,
                1fr
            );
    }

    .footer-gallery-links {
        grid-column: 2 / 3;
    }

    .footer-partners {
        grid-column: 3 / 4;
    }

    .footer-partners__grid {
        grid-template-columns: repeat(3, minmax(62px, auto));
    }
}

@media (max-width: 820px) {
    .site-footer__grid {
        grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-partners {
        grid-column: 1 / -1;
    }

    .footer-partners__grid {
        grid-template-columns: repeat(5, minmax(54px, auto));
        gap: 22px;
    }
}

@media (max-width: 560px) {
    .site-footer {
        padding-top: 42px;
    }

    .site-footer__grid {
        grid-template-columns: 1fr;
        gap: 30px;
        text-align: left;
    }

    .footer-brand,
    .footer-gallery-links,
    .footer-partners {
        grid-column: auto;
    }

    .footer-brand__logo-image {
        max-width: min(210px, 100%);
        max-height: 58px;
    }

    .footer-partners__grid {
        grid-template-columns: repeat(2, minmax(0, auto));
        gap: 22px 26px;
    }

    .footer-partner-card__logo {
        max-width: 124px;
        max-height: 48px;
    }
}

/* Footer kontak ringkas: lokasi klik ke Google Maps, detail penuh tetap di section Hubungi Kami. */
.footer-location-line,
.footer-contact-line {
    margin-bottom: 18px;
    color: #444;
}

.footer-location-line strong,
.footer-contact-line strong {
    display: block;
    margin-bottom: 4px;
    color: #444;
    font-size: 0.92rem;
    font-weight: 900;
}

.footer-location-line a,
.footer-contact-line a {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: #444;
    font-size: 0.9rem;
    line-height: 1.55;
    text-decoration: none;
}

.footer-location-line a::after {
    content: "↗";
    margin-left: 6px;
    color: #f5a623;
    font-size: 0.82rem;
    transform: translateY(-1px);
}

.footer-location-line p {
    margin: 4px 0 0;
    color: #777;
    font-size: 0.86rem;
    line-height: 1.5;
}

.footer-location-line a:hover,
.footer-contact-line a:hover,
.footer-location-line a:focus-visible,
.footer-contact-line a:focus-visible {
    color: #f5a623;
    outline: none;
}

/* Mitra lebih rata: slot grid diisi penuh, logo tetap proporsional, tidak dipaksa kotak. */
.footer-partners {
    max-width: 340px;
}

.footer-partners__grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    justify-items: stretch;
    gap: 20px 12px;
}

.footer-partner-card {
    width: 100%;
    min-width: 0;
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.footer-partner-card__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: min(108px, 100%);
    max-height: 44px;
    object-fit: contain;
}

/* Logo bundar SDIT dijaga agar tidak terlihat kebesaran dibanding logo teks. */
.footer-partner-card:nth-child(2) .footer-partner-card__logo {
    max-width: 66px;
