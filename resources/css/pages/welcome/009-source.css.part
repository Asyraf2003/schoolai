    color: var(--misi-accent);
}

@media (hover: hover) and (pointer: fine) {
    .visi-card:hover,
    .visi-card:focus-visible {
        transform: translateY(-8px) rotate(-0.5deg);
        box-shadow: 0 34px 86px rgba(33, 31, 59, 0.28);
    }

    .misi-card:hover,
    .misi-card:focus-visible {
        transform: translateY(-6px) translateX(6px);
        border-color: color-mix(in srgb, var(--misi-accent) 46%, transparent);
        box-shadow: 0 26px 54px rgba(33, 31, 59, 0.16);
        outline: none;
    }

    .misi-card:hover::before,
    .misi-card:focus-visible::before {
        width: 100%;
        opacity: 0.1;
    }

    .misi-card:hover .misi-card__number,
    .misi-card:focus-visible .misi-card__number {
        background: var(--misi-accent);
        color: #fff;
        transform: rotate(-5deg) scale(1.1);
    }

    .misi-card:hover .misi-card__title,
    .misi-card:focus-visible .misi-card__title {
        color: var(--misi-accent);
    }
}

@media (max-width: 1023px) {
    .visi-misi__shell {
        grid-template-columns: 1fr;
    }

    .visi-card {
        min-height: auto;
    }
}

@media (max-width: 767px) {
    .visi-misi {
        overflow: hidden;
    }

    .visi-card,
    .misi-panel {
        border-radius: 26px;
    }

    .visi-card {
        padding: 28px 22px;
    }

    .misi-panel {
        padding: 20px 16px;
    }

    .misi-card {
        grid-template-columns: 42px 1fr;
        gap: 13px;
        padding: 16px 14px;
        border-radius: 20px;
    }

    .misi-card__number {
        width: 42px;
        height: 42px;
        border-radius: 14px;
    }
}

@keyframes visi-glow-spin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes visi-pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(46, 213, 175, 0.52);
    }

    80%,
    100% {
        box-shadow: 0 0 0 16px rgba(46, 213, 175, 0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .visi-card::before,
    .visi-card__pulse {
        animation: none !important;
    }

    .visi-card,
    .misi-card,
    .misi-card__number {
        transition: none !important;
    }
}

.nilai-section {
    position: relative;
    overflow: hidden;
    padding-bottom: 0;
    background:
        radial-gradient(
            circle at 12% 18%,
            rgba(168, 85, 247, 0.14),
            transparent 32%
        ),
        radial-gradient(
            circle at 86% 22%,
            rgba(34, 197, 94, 0.12),
            transparent 34%
        ),
        linear-gradient(180deg, #fffaf0 0%, #f8fff8 100%);
}

.nilai-section::before,
.nilai-section::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(2px);
    opacity: 0.52;
}

.nilai-section::before {
    width: 280px;
    height: 280px;
    left: -130px;
    top: 70px;
    background: rgba(255, 209, 70, 0.26);
}

.nilai-section::after {
    width: 340px;
    height: 340px;
    right: -160px;
    bottom: 90px;
    background: rgba(14, 165, 233, 0.18);
}

.nilai-section__shell {
    position: relative;
    z-index: 1;
}

.nilai-section__intro {
    max-width: 760px;
    margin-bottom: 34px;
}

.nilai-section__intro .section-title {
    max-width: 820px;
}

.nilai-section__intro .section-subtitle {
    max-width: 720px;
}

.nilai-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    margin-bottom: 88px;
}

.nilai-card {
    position: relative;
