/* =========================================================
   SEKOLAH CERIA NUSANTARA — STYLESHEET
   Struktur file:
   1. Reset & Base
   2. CSS Variables (design tokens)
   3. Tipografi & Utilitas
   4. Navbar
   5. Hero
   6. Elemen dekoratif (floaty, blob, sticker card, wave)
   7. Statistik
   8. Quick Info
   9. PPDB
   10. Visi Misi
   11. Nilai Sekolah
   12. Program Unggulan
   13. Ekstrakurikuler
   14. Galeri & Lightbox
   15. Artikel
   16. Pengumuman
   17. Fasilitas
   18. Kontak & Map
   19. Footer
   20. Scroll-to-top
   21. Animasi reveal
   22. Responsive (tablet & mobile)
   23. Aksesibilitas (reduced motion, focus)
   ========================================================= */

/* ---------- 1. RESET & BASE ---------- */
*,
*::before,
*::after {
    box-sizing: border-box;
}
html {
    width: 100%;
    max-width: 100%;
    scroll-behavior: smooth;
}
body {
    width: 100%;
    max-width: 100%;
    margin: 0;
    background: var(--color-cream);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
}

@supports (overflow: clip) {
    body {
        overflow-x: clip;
    }
}
img,
svg,
video,
iframe {
    max-width: 100%;
    display: block;
}
ul {
    list-style: none;
    margin: 0;
    padding: 0;
}
a {
    color: inherit;
    text-decoration: none;
}
button {
    -webkit-appearance: none;
    appearance: none;
    touch-action: manipulation;
    font: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
}
h1,
h2,
h3,
h4,
p {
    margin: 0;
}

/* ---------- 2. CSS VARIABLES ---------- */
:root {
    /* Warna utama */
    --color-cream: #fff8ec;
    --color-cream-dark: #fcefd8;
    --color-yellow: #ffc93c;
    --color-yellow-soft: #fff0c2;
    --color-blue: #7fc7e0;
    --color-blue-soft: #dcf1f7;
    --color-mint: #7ed9b4;
    --color-mint-soft: #dcf6ea;
    --color-orange: #ff9f5a;
    --color-orange-soft: #ffe5d2;
    --color-pink: #ffafc5;
    --color-pink-soft: #ffe4ec;
    --color-purple: #b7a3e0;
    --color-purple-soft: #ede5fb;

    /* Teks & permukaan */
    --color-ink: #33314d;
    --color-ink-soft: #6c6a85;
    --color-white: #ffffff;

    /* Tipografi (tanpa Google Fonts, murni system font) */
    --font-display:
        ui-rounded, "Segoe UI Rounded", "SF Pro Rounded",
        "Hiragino Maru Gothic ProN", system-ui, -apple-system, "Segoe UI",
        sans-serif;
    --font-body:
        system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
        sans-serif;

    /* Bentuk & bayangan */
    --radius-sm: 14px;
    --radius-md: 22px;
    --radius-lg: 32px;
    --radius-pill: 999px;
    --shadow-soft: 0 10px 30px rgba(51, 49, 77, 0.08);
    --shadow-card: 0 16px 40px rgba(51, 49, 77, 0.12);
    --shadow-float: 0 20px 45px rgba(51, 49, 77, 0.16);

    /* Layout */
    --container-w: 1180px;
    --page-x-gap: 16px;
    --nav-h: 84px;
}

@media (min-width: 768px) {
    :root {
        --page-x-gap: 76px;
    }
}

@media (min-width: 1024px) {
    :root {
        --page-x-gap: 152px;
    }
}

/* ---------- 3. TIPOGRAFI & UTILITAS ---------- */
.container {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding-inline: var(--page-x-gap);
    box-sizing: border-box;
}
.section {
    padding-block: 96px;
    position: relative;
}
.section-head {
    max-width: 640px;
    margin-bottom: 48px;
}
.section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.4vw + 1.5rem, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-ink);
    letter-spacing: -0.01em;
}
.section-title--white {
    color: var(--color-white);
}
.section-subtitle {
    margin-top: 12px;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
