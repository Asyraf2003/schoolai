    display: contents;
}

.artikel-digest__hero,
.artikel-digest-card,
.artikel-digest-card__link {
    min-width: 0;
}

.artikel-digest__hero,
.artikel-digest-card__link {
    display: block;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    box-shadow: none;
    text-decoration: none;
    overflow: visible;
}

.artikel-digest__hero-media,
.artikel-digest-card__media {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    background: #f1efe9;
}

.artikel-digest__media-image,
.artikel-digest-card__media-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1);
    transition:
        transform 0.28s ease,
        filter 0.28s ease;
}

.artikel-digest__issue,
.artikel-digest-card__issue,
.artikel-digest__spark {
    display: none;
}

.artikel-digest__emoji,
.artikel-digest-card__emoji {
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
}

.artikel-digest__hero-body,
.artikel-digest-card__content {
    display: grid;
    gap: 9px;
    padding-top: 16px;
}

.artikel-digest__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: rgba(31, 31, 31, 0.48);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0;
    text-transform: none;
}

.artikel-digest__meta span {
    display: inline-flex;
    align-items: center;
}

.artikel-digest__meta span + span::before {
    content: "—";
    margin-right: 8px;
    color: rgba(31, 31, 31, 0.34);
}

.artikel-digest__hero-title,
.artikel-digest-card__title {
    display: block;
    margin: 0;
    color: #171717;
    font-family: var(--font-body);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.035em;
}

.artikel-digest__hero-title {
    display: -webkit-box;
    overflow: hidden;
    font-size: clamp(1.28rem, 1.45vw, 1.72rem);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.artikel-digest-card__title {
    display: -webkit-box;
    overflow: hidden;
    font-size: clamp(1.28rem, 1.45vw, 1.72rem);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.artikel-digest__hero-title a {
    color: inherit;
    text-decoration: none;
}

.artikel-digest__hero-description,
.artikel-digest-card__description {
    display: -webkit-box;
    overflow: hidden;
    color: rgba(31, 31, 31, 0.74);
    font-size: 0.98rem;
    line-height: 1.55;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.artikel-digest__highlight,
.artikel-digest-card__highlight {
    display: none;
}

.artikel-digest__cta {
    width: fit-content;
    margin-top: 3px;
    color: rgba(31, 31, 31, 0.56);
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
}

.artikel-digest__cta span {
    transition: transform 0.22s ease;
}

.artikel-section__action {
    margin-top: clamp(30px, 4vw, 48px);
    text-align: center;
}

@media (hover: hover) and (pointer: fine) {
    .artikel-digest__hero:hover .artikel-digest__media-image,
    .artikel-digest-card__link:hover .artikel-digest-card__media-image,
    .artikel-digest-card__link:focus-visible .artikel-digest-card__media-image {
        transform: scale(1.045);
        filter: saturate(1.05) contrast(1.03);
    }

    .artikel-digest__hero:hover .artikel-digest__hero-title a,
    .artikel-digest-card__link:hover .artikel-digest-card__title,
    .artikel-digest-card__link:focus-visible .artikel-digest-card__title,
    .artikel-digest__hero-title a:focus-visible {
        color: #d95d1e;
    }

    .artikel-digest__hero:hover .artikel-digest__cta {
        color: #d95d1e;
    }

    .artikel-digest__hero:hover .artikel-digest__cta span {
        transform: translateX(4px);
    }
}

.artikel-digest-card__link:focus-visible,
.artikel-digest__hero-title a:focus-visible,
.artikel-digest__cta:focus-visible {
    outline: 3px solid rgba(255, 159, 90, 0.38);
