}

.galeri-card--wide {
    grid-column: span 3;
}

.galeri-card--tall {
    grid-column: span 2;
    min-height: 400px;
}

.galeri-card--feature {
    grid-column: span 4;
    min-height: 400px;
}

.galeri-card--video {
    box-shadow: 0 22px 54px rgba(18, 18, 24, 0.28);
}

.galeri-card__media {
    position: relative;
    min-height: 168px;
    display: grid;
    place-items: center;
    overflow: hidden;
}

.galeri-card--tall .galeri-card__media,
.galeri-card--feature .galeri-card__media {
    min-height: 220px;
}

.galeri-card__image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
}

.galeri-card__fallback {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.22);
    color: var(--color-white);
    font-size: 3rem;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.32);
}

.galeri-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.88);
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(18, 18, 24, 0.16);
}

.galeri-card__play {
    position: absolute;
    inset: auto 18px 18px auto;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--gallery-accent);
    font-size: 1.05rem;
    font-weight: 900;
    box-shadow: 0 14px 28px rgba(18, 18, 24, 0.2);
}

.galeri-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    color: var(--color-white);
}

.galeri-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.78rem;
    font-weight: 700;
}

.galeri-card__meta span {
    display: inline-flex;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.16);
}

.galeri-card__title {
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 0.6vw + 0.96rem, 1.42rem);
    line-height: 1.2;
    text-shadow: 0 2px 10px rgba(18, 18, 24, 0.24);
}

.galeri-card__caption {
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.92rem;
    line-height: 1.55;
}

.galeri-card__link {
    display: inline-flex;
    width: fit-content;
    margin-top: auto;
    padding: 9px 14px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-ink);
    font-size: 0.86rem;
    font-weight: 800;
}

.galeri-card__link--disabled {
    background: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.8);
}

.galeri-section__action {
    display: flex;
    justify-content: center;
    margin-top: 34px;
}

@media (max-width: 1024px) {
    .galeri-grid--teaser {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .galeri-card,
    .galeri-card--normal,
    .galeri-card--wide,
    .galeri-card--tall,
    .galeri-card--feature {
        grid-column: auto;
        min-height: 330px;
    }
}

@media (max-width: 720px) {
    .galeri-grid--teaser {
        grid-template-columns: 1fr;
    }

    .galeri-card,
    .galeri-card--normal,
    .galeri-card--wide,
    .galeri-card--tall,
    .galeri-card--feature {
        min-height: 300px;
    }

    .galeri-card__media {
        min-height: 160px;
    }
}

/* Premium compact gallery, Buffer-like: centered header, white background, sticky visual track. */
