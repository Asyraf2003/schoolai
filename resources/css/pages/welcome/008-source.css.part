
.vm-mark--green {
    --vm-mark-color: #86efac;
    --vm-mark-bg: rgba(34, 197, 94, 0.22);
}

.vm-mark--purple {
    --vm-mark-color: #d8b4fe;
    --vm-mark-bg: rgba(168, 85, 247, 0.2);
}

.misi-panel {
    position: relative;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 34px;
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid rgba(255, 255, 255, 0.92);
    box-shadow: 0 24px 60px rgba(33, 31, 59, 0.12);
    backdrop-filter: blur(18px);
}

.misi-panel__head {
    display: grid;
    gap: 12px;
    margin-bottom: 22px;
}

.misi-panel__kicker {
    background: #211f3b;
    color: #fff2b9;
}

.misi-panel__head h3 {
    margin: 0;
    max-width: 580px;
    font-family: var(--font-display);
    font-size: clamp(1.48rem, 2vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
    color: #211f3b;
}

.misi-list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.misi-list__item {
    margin: 0;
}

.misi-card {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
    padding: 18px 18px;
    border: 1px solid rgba(33, 31, 59, 0.08);
    border-radius: 24px;
    background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.96),
        rgba(255, 251, 241, 0.86)
    );
    color: #211f3b;
    box-shadow: 0 16px 34px rgba(33, 31, 59, 0.08);
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition:
        transform 0.28s ease,
        border-color 0.28s ease,
        box-shadow 0.28s ease,
        background 0.28s ease;
}

.misi-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 6px;
    background: var(--misi-accent);
    opacity: 0.9;
    transition:
        width 0.28s ease,
        opacity 0.28s ease;
    z-index: -1;
}

.misi-card::after {
    content: "";
    position: absolute;
    width: 160px;
    height: 160px;
    right: -94px;
    top: -100px;
    border-radius: 999px;
    background: var(--misi-accent);
    opacity: 0.1;
    transition:
        transform 0.28s ease,
        opacity 0.28s ease;
    z-index: -1;
}

.misi-card__number {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--misi-accent) 14%, #ffffff);
    color: var(--misi-accent);
    font-family: var(--font-display);
    font-weight: 950;
    font-size: 1rem;
    box-shadow: inset 0 0 0 1px
        color-mix(in srgb, var(--misi-accent) 26%, transparent);
    transition:
        transform 0.28s ease,
        background 0.28s ease,
        color 0.28s ease;
}

.misi-card__body {
    display: grid;
    gap: 7px;
}

.misi-card__title {
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 950;
    line-height: 1.12;
    color: #211f3b;
    transition: color 0.28s ease;
}

.misi-card__text {
    display: block;
    color: rgba(33, 31, 59, 0.76);
    font-weight: 650;
    line-height: 1.58;
    transition: color 0.28s ease;
}

.misi-card .vm-mark::after {
    height: 0.42em;
    bottom: -0.02em;
}

.misi-card.is-active {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--misi-accent) 42%, transparent);
    box-shadow: 0 24px 48px rgba(33, 31, 59, 0.14);
}

.misi-card.is-active::before {
    width: 100%;
    opacity: 0.1;
}

.misi-card.is-active::after {
    opacity: 0.18;
    transform: translate(-22px, 28px) scale(1.12);
}

.misi-card.is-active .misi-card__number {
    background: var(--misi-accent);
    color: #ffffff;
    transform: rotate(-5deg) scale(1.08);
}

.misi-card.is-active .misi-card__title {
