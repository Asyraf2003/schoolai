    min-height: 320px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 22px;
    padding: 24px;
    border: 1px solid rgba(33, 31, 59, 0.08);
    border-radius: 30px;
    background: linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.96),
        rgba(255, 251, 241, 0.86)
    );
    color: #211f3b;
    box-shadow: 0 18px 44px rgba(33, 31, 59, 0.08);
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transform: translateY(0) rotate(0deg);
    transition:
        transform 0.32s ease,
        border-color 0.32s ease,
        box-shadow 0.32s ease,
        background 0.32s ease;
}

.nilai-card::before {
    content: "";
    position: absolute;
    inset: auto 18px 18px 18px;
    height: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nilai-accent) 70%, #ffffff);
    opacity: 0.75;
    transform: scaleX(0.35);
    transform-origin: left;
    transition:
        transform 0.32s ease,
        opacity 0.32s ease;
}

.nilai-card::after {
    content: "";
    position: absolute;
    width: 210px;
    height: 210px;
    right: -118px;
    top: -118px;
    border-radius: 999px;
    background: var(--nilai-accent);
    opacity: 0.11;
    z-index: -1;
    transition:
        opacity 0.32s ease,
        transform 0.32s ease;
}

.nilai-card__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
        radial-gradient(
            circle at 18% 18%,
            color-mix(in srgb, var(--nilai-accent) 18%, transparent),
            transparent 32%
        ),
        radial-gradient(
            circle at 84% 74%,
            color-mix(in srgb, var(--nilai-accent) 12%, transparent),
            transparent 36%
        );
    opacity: 0;
    transition: opacity 0.32s ease;
}

.nilai-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}

.nilai-card__code {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 22px;
    background: color-mix(in srgb, var(--nilai-accent) 13%, #ffffff);
    color: var(--nilai-accent);
    font-family: var(--font-display);
    font-weight: 950;
    font-size: 2rem;
    line-height: 1;
    box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--nilai-accent) 22%, transparent),
        0 14px 26px rgba(33, 31, 59, 0.08);
    transition:
        transform 0.32s ease,
        background 0.32s ease,
        color 0.32s ease,
        box-shadow 0.32s ease;
}

.nilai-card__spark {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background:
        radial-gradient(
            circle at 50% 50%,
            var(--nilai-accent) 0 19%,
            transparent 20%
        ),
        conic-gradient(
            from 0deg,
            transparent 0 18%,
            color-mix(in srgb, var(--nilai-accent) 58%, transparent) 18% 24%,
            transparent 24% 43%,
            color-mix(in srgb, var(--nilai-accent) 54%, transparent) 43% 49%,
            transparent 49% 68%,
            color-mix(in srgb, var(--nilai-accent) 50%, transparent) 68% 74%,
            transparent 74%
        );
    opacity: 0.42;
    transition:
        transform 0.32s ease,
        opacity 0.32s ease;
}

.nilai-card__content {
    display: grid;
    gap: 10px;
}

.nilai-card__title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.32rem, 1vw + 1rem, 1.74rem);
    font-weight: 950;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #211f3b;
    transition: color 0.32s ease;
}

.nilai-card__summary {
    display: block;
    color: color-mix(in srgb, var(--nilai-accent) 78%, #211f3b);
    font-weight: 880;
    line-height: 1.32;
}

.nilai-card__description {
    display: block;
    color: rgba(33, 31, 59, 0.74);
    font-weight: 640;
    line-height: 1.62;
}

.nilai-mark {
    position: relative;
    display: inline;
    color: var(--nilai-mark-color, #211f3b);
    font-weight: 950;
    z-index: 0;
}

.nilai-mark::after {
    content: "";
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    bottom: 0.01em;
    height: 0.38em;
    z-index: -1;
    border-radius: 999px;
    background: var(--nilai-mark-bg, rgba(255, 209, 70, 0.28));
