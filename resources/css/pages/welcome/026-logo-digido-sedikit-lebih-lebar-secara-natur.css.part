    max-height: 54px;
}

/* Logo Digido sedikit lebih lebar secara natural, tapi tetap tidak merusak layout. */
.footer-partner-card:nth-child(5) .footer-partner-card__logo {
    max-width: min(128px, 100%);
    max-height: 48px;
}

@media (max-width: 820px) {
    .footer-partners {
        max-width: none;
        width: 100%;
    }

    .footer-partners__grid {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 20px 14px;
    }

    .footer-partner-card__logo {
        max-width: min(118px, 100%);
    }
}

@media (max-width: 560px) {
    .footer-partners__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 18px;
    }

    .footer-partner-card {
        min-height: 58px;
    }

    .footer-partner-card:last-child:nth-child(odd) {
        grid-column: 1 / -1;
    }

    .footer-partner-card__logo {
        max-width: min(132px, 100%);
        max-height: 46px;
    }

    .footer-partner-card:nth-child(2) .footer-partner-card__logo {
        max-width: 68px;
        max-height: 54px;
    }

    .footer-partner-card:nth-child(5) .footer-partner-card__logo {
        max-width: min(148px, 100%);
        max-height: 48px;
    }
}

/* Kontak scroll ke footer, Bahasa masih dummy, social icon pakai inline SVG. */
.nav-link--dummy {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: default;
    color: rgba(31, 46, 43, 0.55);
    user-select: none;
}

.nav-link--dummy:hover {
    color: rgba(31, 46, 43, 0.55);
}

.nav-link__badge {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 20px;
    padding-inline: 7px;
    border-radius: 999px;
    background: rgba(245, 166, 35, 0.14);
    color: #c47a00;
    font-size: 0.66rem;
    font-weight: 950;
    line-height: 1;
    letter-spacing: 0.04em;
}

.footer-social a {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #5f5f5f;
}

.footer-social a::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #ffc04d, #ff8a3d);
    opacity: 0;
    transition: opacity 0.24s ease;
    z-index: -1;
}

.footer-social a:hover::before,
.footer-social a:focus-visible::before {
    opacity: 1;
}

.footer-social__icon {
    width: 18px;
    height: 18px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.footer-social__dot {
    fill: currentColor;
    stroke: none;
}

.footer-social__fallback {
    position: relative;
    z-index: 1;
    font-size: 0.76rem;
    font-weight: 950;
}

@media (max-width: 560px) {
    .nav-link--dummy {
        opacity: 0.72;
    }

    .footer-social a {
        width: 42px;
        height: 42px;
    }

    .footer-social__icon {
        width: 19px;
        height: 19px;
    }
}

/* WA, IG, FB, Email jadi satu UI seragam berbasis inline SVG. */
.footer-channel-group {
    margin-top: 22px;
}

.footer-channel-group > strong {
    display: block;
    margin-bottom: 12px;
    color: #444;
    font-size: 0.92rem;
    font-weight: 900;
}

.footer-channel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    max-width: 310px;
}

.footer-channel {
    --channel-accent: #f5a623;
    position: relative;
    min-width: 0;
    min-height: 58px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(31, 46, 43, 0.08);
    border-radius: 16px;
    background: #f7f7f7;
    color: #3f3f3f;
