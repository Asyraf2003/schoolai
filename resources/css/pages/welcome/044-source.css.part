        max-height: 520px;
    }
}

.homepage-gallery-lightbox[hidden] {
    display: none;
}

.homepage-gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: 10px;
}

.homepage-gallery-lightbox__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(31, 30, 46, 0.74);
    backdrop-filter: blur(8px);
}

.homepage-gallery-lightbox__panel {
    position: relative;
    width: fit-content;
    max-width: 100%;
    max-height: calc(100dvh - 20px);
    overflow: visible;
    padding: 9px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 27px;
    background: var(--color-white);
    box-shadow: var(--shadow-float);
}

.homepage-gallery-lightbox__close {
    position: absolute;
    right: 17px;
    top: 17px;
    z-index: 4;
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-white);
    font-weight: 900;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
}

.homepage-gallery-lightbox__media {
    display: grid;
    place-items: center;
    width: min(960px, calc(100vw - 38px));
    min-width: 0;
    min-height: 0;
    border-radius: 19px;
    background: #111827;
    overflow: hidden;
}

.homepage-gallery-lightbox__media.is-landscape {
    width: min(960px, calc(100vw - 38px), calc(177.78dvh - 68px));
    aspect-ratio: 16 / 9;
}

.homepage-gallery-lightbox__media.is-portrait {
    width: min(420px, calc(100vw - 38px), calc(56.25dvh - 22px));
    aspect-ratio: 9 / 16;
}

.homepage-gallery-lightbox__media.is-square {
    width: min(760px, calc(100vw - 38px), calc(100dvh - 38px));
    aspect-ratio: 1;
}

.homepage-gallery-lightbox__media.is-image {
    width: auto;
}

.homepage-gallery-lightbox__media img,
.homepage-gallery-lightbox__media iframe {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    border: 0;
    object-fit: contain;
    background: #111827;
    display: block;
}

.homepage-gallery-lightbox__media.is-image img {
    width: auto;
    height: auto;
    max-width: calc(100vw - 38px);
    max-height: calc(100dvh - 38px);
}

@media (max-width: 640px) {
    .homepage-gallery-lightbox {
        padding: 6px;
    }

    .homepage-gallery-lightbox__panel {
        max-height: calc(100dvh - 12px);
        padding: 6px;
        border-radius: 20px;
    }

    .homepage-gallery-lightbox__media {
        border-radius: 14px;
    }

    .homepage-gallery-lightbox__close {
        position: fixed;
        right: 12px;
        top: max(12px, env(safe-area-inset-top));
        z-index: 4;
    }
}

.galeri-story-visual__panel.is-active,
.galeri-story-visual__media,
.galeri-story-visual__play,
.galeri-story-card__mobile-media,
.galeri-story-card__mobile-play {
    cursor: pointer;
}

.galeri-story-visual__panel:focus-visible,
.galeri-story-card:focus-visible {
    outline: 3px solid rgba(255, 201, 60, 0.82);
    outline-offset: 4px;
}

.visi-misi__head,
.program-section__head,
.galeri-section__head {
    max-width: 880px;
    margin-inline: auto;
    margin-bottom: clamp(26px, 4vw, 46px);
    text-align: center;
}

.visi-misi__head .section-title,
.program-section__head .section-title {
    margin-inline: auto;
}

.visi-misi__head .section-subtitle,
.program-section__head .section-subtitle,
.galeri-section__head .section-subtitle {
    margin-top: 12px;
    margin-inline: auto;
}

.galeri-section__head {
    position: relative;
    z-index: 2;
}

.galeri-section__head .section-title {
    display: block;
    color: var(--color-white);
    text-shadow: 0 14px 34px rgba(31, 30, 46, 0.22);
}

.galeri-section__head .section-subtitle {
    color: rgba(255, 255, 255, 0.88);
}

.galeri-section__head {
    max-width: 760px;
    margin-inline: auto;
    margin-bottom: clamp(34px, 4.5vw, 62px);
    text-align: center;
}

