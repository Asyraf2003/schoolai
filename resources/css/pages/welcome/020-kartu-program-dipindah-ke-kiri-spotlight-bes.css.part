}

.artikel-side-card__body {
    min-width: 0;
}

.artikel-side-card__title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.25;
}

.artikel-side-card p {
    margin: 0;
    color: rgba(31, 46, 43, 0.7);
    font-size: 0.9rem;
    line-height: 1.65;
}

.artikel-empty {
    margin: 0;
    padding: 22px 24px;
    border: 1px dashed rgba(31, 46, 43, 0.18);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-ink-soft);
    text-align: center;
}

@media (max-width: 1024px) {
    .artikel-editorial {
        grid-template-columns: 1fr;
    }

    .artikel-featured {
        grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1fr);
        grid-template-rows: auto;
    }

    .artikel-featured__media {
        min-height: 100%;
    }
}

@media (max-width: 720px) {
    .artikel-section__head {
        text-align: left;
    }

    .artikel-featured {
        grid-template-columns: 1fr;
        border-radius: 28px;
    }

    .artikel-featured__media {
        min-height: 190px;
    }

    .artikel-featured__body {
        padding: 24px;
    }

    .artikel-side-card {
        grid-template-columns: 1fr;
        min-height: auto;
        padding: 16px;
        border-radius: 24px;
    }

    .artikel-side-card__icon {
        min-height: 112px;
    }

    .artikel-meta {
        font-size: 0.72rem;
    }
}

/* Kartu program dipindah ke kiri, spotlight besar ke kanan. */
.program-section__shell {
    grid-template-columns: minmax(0, 1.22fr) minmax(280px, 0.78fr);
}

.program-flow {
    order: 1;
}

.program-spotlight {
    order: 2;
}

@media (max-width: 1100px) {
    .program-section__shell {
        grid-template-columns: 1fr;
    }

    .program-flow,
    .program-spotlight {
        order: initial;
    }
}

/* Versi artikel lebih hidup: parent digest, issue cards, dan rail dinamis tanpa JS tambahan. */
.artikel-section--digest {
    position: relative;
    overflow: clip;
    background:
        radial-gradient(
            circle at 9% 12%,
            rgba(255, 210, 92, 0.24),
            transparent 30%
        ),
        radial-gradient(
            circle at 88% 16%,
            rgba(124, 92, 255, 0.16),
            transparent 28%
        ),
        radial-gradient(
            circle at 52% 96%,
            rgba(139, 224, 195, 0.2),
            transparent 28%
        ),
        linear-gradient(
            180deg,
            rgba(255, 252, 244, 0.98),
            rgba(255, 255, 255, 0.94)
        );
}

.artikel-section--digest::before {
    content: "";
    position: absolute;
    inset: 96px auto auto 5%;
    width: 128px;
    height: 128px;
    border-radius: 42% 58% 54% 46%;
    background: rgba(255, 143, 171, 0.14);
    transform: rotate(-10deg);
    pointer-events: none;
}

.artikel-section--digest::after {
    content: "";
    position: absolute;
    right: 8%;
    bottom: 110px;
    width: 92px;
    height: 92px;
    border-radius: 999px;
    background: rgba(151, 213, 255, 0.18);
    pointer-events: none;
}

/* Homepage artikel publik: clean editorial grid, gambar 16:9 cover, teks di bawah, tanpa card berat. */
.artikel-section--digest {
    position: relative;
    overflow: clip;
    background: #fffaf0;
}

.artikel-section--digest .container {
    position: relative;
    z-index: 1;
}

.artikel-section__head {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
}

.artikel-digest {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(26px, 3vw, 44px);
    align-items: start;
}

.artikel-digest__rail {
