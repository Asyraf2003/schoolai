        ),
        linear-gradient(135deg, #ff9f5a, #1a7594);
    box-shadow: var(--shadow-float);
}

.public-final-cta__box span {
    font-size: 3rem;
}

.public-final-cta__box h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 3.4rem);
    line-height: 1.05;
}

.public-final-cta__box p {
    max-width: 620px;
    color: rgba(255, 255, 255, 0.86);
}

.article-hero-card {
    padding: clamp(28px, 6vw, 68px);
    border-radius: 42px;
    background:
        radial-gradient(
            circle at 90% 12%,
            rgba(255, 201, 60, 0.32),
            transparent 22%
        ),
        linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.92),
            rgba(237, 229, 251, 0.82)
        );
    box-shadow: var(--shadow-card);
}

.article-toolbar {
    margin-top: 28px;
    display: grid;
    gap: 16px;
}

.article-search {
    width: min(100%, 520px);
    padding: 16px 20px;
    border: 2px solid rgba(51, 49, 77, 0.09);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
    font-weight: 700;
    outline: none;
}

.article-search:focus {
    border-color: var(--color-orange);
    box-shadow: 0 0 0 4px rgba(255, 159, 90, 0.16);
}

.public-filter-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.public-filter-row--center {
    justify-content: center;
    margin-bottom: 34px;
}

.public-filter-chip {
    padding: 10px 16px;
    background: var(--color-white);
    color: var(--color-ink-soft);
    border: 1px solid rgba(51, 49, 77, 0.08);
    box-shadow: var(--shadow-soft);
}

.public-filter-chip:hover,
.public-filter-chip.is-active {
    background: var(--color-orange);
    color: var(--color-white);
    transform: translateY(-2px);
}

.featured-article {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    padding: clamp(24px, 4vw, 42px);
    border-radius: 38px;
    background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.94),
        rgba(220, 246, 234, 0.86)
    );
    box-shadow: var(--shadow-card);
}

.featured-article__issue {
    min-height: 220px;
    display: grid;
    place-items: center;
    padding: 24px;
    border-radius: 30px;
    background: var(--color-yellow);
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 900;
    text-align: center;
    color: #7a4c00;
}

.featured-article h2 {
    margin-top: 12px;
    font-size: clamp(1.7rem, 2.4vw, 3rem);
}

.article-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.article-list-card {
    padding: 22px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
}

.article-list-card__top,
.article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.article-list-card__issue {
    font-family: var(--font-display);
    color: #c25e1e;
    font-weight: 900;
}

.article-list-card .link-arrow {
    margin-top: auto;
    padding-top: 18px;
}

.article-meta {
    margin: 16px 0;
    color: var(--color-ink-soft);
    font-size: 0.88rem;
    font-weight: 800;
}

.gallery-hero-stack {
    min-height: 360px;
    position: relative;
    border-radius: 42px;
    background:
        radial-gradient(
            circle at 20% 20%,
            var(--color-yellow),
            transparent 20%
        ),
        linear-gradient(135deg, var(--color-blue-soft), var(--color-pink-soft));
    box-shadow: var(--shadow-card);
}

.gallery-hero-stack span {
    position: absolute;
    display: grid;
    place-items: center;
    width: 138px;
    height: 138px;
    border-radius: 34px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: var(--shadow-float);
