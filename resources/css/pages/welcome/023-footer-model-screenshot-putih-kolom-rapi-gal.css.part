.footer-contact p {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0 0 12px;
    color: rgba(31, 46, 43, 0.72);
    font-size: 0.92rem;
    line-height: 1.62;
}

.footer-partners {
    margin-top: clamp(30px, 5vw, 50px);
    padding: clamp(22px, 4vw, 34px);
    border: 1px solid rgba(31, 46, 43, 0.08);
    border-radius: 34px;
    background:
        radial-gradient(
            circle at 10% 10%,
            rgba(255, 210, 92, 0.13),
            transparent 24%
        ),
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.94),
            rgba(255, 252, 244, 0.9)
        );
    box-shadow: 0 24px 72px rgba(31, 46, 43, 0.08);
}

.footer-partners__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
}

.footer-partners__head h4 {
    margin-bottom: 0;
    font-size: clamp(1.35rem, 2.2vw, 2rem);
}

.footer-partners__head p {
    max-width: 620px;
    margin: 0;
    color: rgba(31, 46, 43, 0.64);
    font-size: 0.92rem;
    line-height: 1.62;
}

.footer-partners__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
}

.footer-partner-card {
    min-height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    border: 1px solid rgba(31, 46, 43, 0.08);
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 14px 34px rgba(31, 46, 43, 0.06);
    text-decoration: none;
    transition:
        transform 0.24s ease,
        box-shadow 0.24s ease,
        border-color 0.24s ease;
}

.footer-partner-card:hover,
.footer-partner-card:focus-visible {
    transform: translateY(-5px);
    border-color: rgba(124, 92, 255, 0.18);
    box-shadow: 0 24px 56px rgba(31, 46, 43, 0.11);
    outline: none;
}

.footer-partner-card__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: min(150px, 100%);
    max-height: 54px;
    object-fit: contain;
}

.site-footer__bottom {
    position: relative;
    z-index: 1;
    padding: 24px 0 28px;
    color: rgba(31, 46, 43, 0.58);
    font-size: 0.86rem;
    text-align: center;
}

@media (max-width: 1024px) {
    .site-footer__grid {
        grid-template-columns: 1.2fr 0.8fr;
    }

    .footer-contact {
        grid-column: 1 / -1;
    }

    .footer-partners__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 720px) {
    .site-footer__grid {
        grid-template-columns: 1fr;
        text-align: left;
    }

    .footer-partners {
        border-radius: 26px;
        padding: 20px;
    }

    .footer-partners__head {
        display: grid;
        gap: 10px;
    }

    .footer-partners__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-partner-card {
        min-height: 92px;
        padding: 14px;
        border-radius: 20px;
    }

    .footer-partner-card__logo {
        max-width: min(128px, 100%);
        max-height: 46px;
    }
}

@media (max-width: 420px) {
    .footer-partners__grid {
        grid-template-columns: 1fr;
    }

    .footer-partner-card__logo {
        max-height: 48px;
    }
}

/* Footer model screenshot: putih, kolom rapi, galeri hanya tautan, logo partner proporsional. */
.site-footer {
    position: relative;
    overflow: clip;
    background: #ffffff;
    color: #444;
    padding-top: clamp(46px, 6vw, 72px);
    border-top: 1px solid rgba(0, 0, 0, 0.06);
}

.site-footer::before,
.site-footer::after {
    display: none;
}

.site-footer__grid {
    display: grid;
    grid-template-columns: minmax(300px, 1.35fr) minmax(150px, 0.7fr) minmax(
            170px,
            0.82fr
        ) minmax(280px, 1.1fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: start;
    padding-bottom: clamp(36px, 5vw, 58px);
    border-bottom: 0;
