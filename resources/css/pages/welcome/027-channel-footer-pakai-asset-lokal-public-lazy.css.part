    text-decoration: none;
    box-shadow: 0 10px 26px rgba(31, 46, 43, 0.04);
    transition:
        transform 0.22s ease,
        border-color 0.22s ease,
        color 0.22s ease,
        box-shadow 0.22s ease;
}

.footer-channel::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(
            circle at 18% 12%,
            rgba(255, 255, 255, 0.56),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            color-mix(in srgb, var(--channel-accent) 28%, #ffffff),
            #ffffff
        );
    opacity: 0;
    transition: opacity 0.22s ease;
    z-index: -1;
}

.footer-channel:hover,
.footer-channel:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--channel-accent) 42%, transparent);
    color: #1f1f1f;
    box-shadow: 0 16px 34px rgba(31, 46, 43, 0.08);
    outline: none;
}

.footer-channel:hover::before,
.footer-channel:focus-visible::before {
    opacity: 1;
}

.footer-channel--whatsapp {
    --channel-accent: #25d366;
}

.footer-channel--instagram {
    --channel-accent: #e1306c;
}

.footer-channel--facebook {
    --channel-accent: #1877f2;
}

.footer-channel--email {
    --channel-accent: #f5a623;
}

.footer-channel--disabled {
    cursor: not-allowed;
    opacity: 0.72;
}

.footer-channel--disabled:hover {
    transform: none;
    box-shadow: 0 10px 26px rgba(31, 46, 43, 0.04);
}

.footer-channel__icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.footer-channel--facebook .footer-channel__icon {
    fill: currentColor;
    stroke: none;
}

.footer-channel__dot {
    fill: currentColor;
    stroke: none;
}

.footer-channel__body {
    min-width: 0;
    display: grid;
    gap: 2px;
}

.footer-channel__label {
    color: inherit;
    font-size: 0.84rem;
    font-weight: 950;
    line-height: 1.1;
}

.footer-channel__note {
    color: #777;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.footer-channel:hover .footer-channel__note,
.footer-channel:focus-visible .footer-channel__note {
    color: rgba(31, 31, 31, 0.72);
}

@media (max-width: 560px) {
    .footer-channel-grid {
        max-width: none;
    }

    .footer-channel {
        min-height: 56px;
        padding: 10px;
    }

    .footer-channel__icon {
        width: 21px;
        height: 21px;
    }
}

/* Channel footer pakai asset lokal public + lazy img agar render awal tetap ringan. */
.footer-channel {
    min-height: 60px;
}

.footer-channel__asset {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    display: block;
    object-fit: contain;
    transform: translateZ(0);
    transition:
        transform 0.22s ease,
        filter 0.22s ease,
        opacity 0.22s ease;
}

.footer-channel:hover .footer-channel__asset,
.footer-channel:focus-visible .footer-channel__asset {
    transform: translateY(-1px) scale(1.08) rotate(-3deg);
}

.footer-channel--disabled .footer-channel__asset {
    filter: saturate(0.55) opacity(0.72);
}

.footer-channel__fallback {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(31, 46, 43, 0.08);
    color: #444;
    font-size: 0.7rem;
    font-weight: 950;
}

@media (max-width: 560px) {
    .footer-channel__asset,
    .footer-channel__fallback {
        width: 26px;
        height: 26px;
        flex-basis: 26px;
