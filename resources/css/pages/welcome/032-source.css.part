    font-size: 3rem;
    box-shadow: var(--shadow-float);
}

.ppdb-mini-card {
    position: relative;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 14px;
    padding: 18px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-soft);
}

.ppdb-mini-card span,
.program-public-card__icon {
    font-size: 2rem;
}

.ppdb-mini-card h2,
.public-step-card h3,
.program-public-card h3,
.timeline-card h3,
.article-list-card h2,
.featured-article h2,
.faq-card summary {
    font-family: var(--font-display);
    color: var(--color-ink);
    line-height: 1.2;
}

.ppdb-mini-card p,
.public-step-card p,
.program-public-card p,
.timeline-card p,
.article-list-card p,
.featured-article p,
.faq-card p {
    margin-top: 8px;
    color: var(--color-ink-soft);
}

.public-step-grid,
.program-public-grid,
.faq-grid,
.article-grid {
    display: grid;
    gap: 18px;
}

.public-step-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.public-step-card,
.program-public-card,
.article-list-card,
.faq-card,
.timeline-card {
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-soft);
    border: 1px solid rgba(51, 49, 77, 0.07);
}

.public-step-card {
    padding: 24px;
}

.public-step-card__number {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 18px;
    border-radius: 18px;
    background: var(--color-orange-soft);
    color: #c25e1e;
    font-weight: 900;
}

.program-public-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.program-public-card {
    padding: 24px;
}

.program-public-card__age,
.article-chip,
.public-gallery-card__badge {
    display: inline-flex;
    width: fit-content;
    margin: 10px 0;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-blue-soft);
    color: #1a7594;
    font-weight: 900;
    font-size: 0.82rem;
}

.ppdb-info-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 34px;
}

.document-list {
    display: grid;
    gap: 12px;
}

.document-list li {
    position: relative;
    padding: 16px 18px 16px 48px;
    border-radius: 20px;
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
    color: var(--color-ink-soft);
    font-weight: 700;
}

.document-list li::before {
    content: "✓";
    position: absolute;
    left: 18px;
    top: 15px;
    color: #1f8f63;
    font-weight: 900;
}

.timeline-list {
    display: grid;
    gap: 14px;
}

.timeline-card {
    padding: 20px;
}

.timeline-card span {
    color: #c25e1e;
    font-weight: 900;
}

.faq-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.faq-card {
    padding: 22px;
}

.faq-card summary {
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 900;
}

.public-final-cta {
    padding: 72px 0 96px;
}

.public-final-cta__box {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: clamp(34px, 6vw, 70px);
    border-radius: 38px;
    text-align: center;
    color: var(--color-white);
    background:
        radial-gradient(
            circle at 16% 20%,
            rgba(255, 255, 255, 0.26),
            transparent 24%
