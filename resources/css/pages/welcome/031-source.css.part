    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
}

.public-nav__link,
.public-language a,
.public-filter-chip {
    border-radius: var(--radius-pill);
    font-weight: 800;
    transition:
        transform 0.2s ease,
        background 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease;
}

.public-nav__link {
    padding: 10px 14px;
    color: var(--color-ink-soft);
}

.public-nav__link:hover,
.public-nav__link.is-active {
    background: var(--color-white);
    color: #c25e1e;
    box-shadow: var(--shadow-soft);
    transform: translateY(-1px);
}

.public-language {
    display: inline-flex;
    gap: 4px;
    padding: 5px;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    border: 1px solid rgba(51, 49, 77, 0.08);
}

.public-language a {
    padding: 7px 10px;
    font-size: 0.82rem;
    color: var(--color-ink-soft);
}

.public-language a.is-active {
    background: var(--color-orange);
    color: var(--color-white);
}

.public-hero {
    position: relative;
    padding: 88px 0 72px;
}

.public-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
    gap: 42px;
    align-items: center;
}

.public-hero__copy {
    max-width: 760px;
}

.public-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.2vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--color-ink);
}

.public-hero__subtitle {
    max-width: 720px;
    margin-top: 18px;
    color: var(--color-ink-soft);
    font-size: clamp(1rem, 0.3vw + 1rem, 1.2rem);
}

.public-hero__actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.public-note {
    margin-top: 14px;
    color: var(--color-ink-soft);
    font-weight: 700;
}

.public-stat-row {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

.public-stat-row div {
    padding: 16px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-soft);
}

.public-stat-row strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.65rem;
    color: #c25e1e;
}

.public-stat-row span {
    color: var(--color-ink-soft);
    font-weight: 700;
    font-size: 0.92rem;
}

.public-section {
    padding: 84px 0;
}

.public-section--soft {
    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.55),
            rgba(255, 248, 236, 0.4)
        ),
        var(--color-cream-dark);
}

.public-section-head {
    max-width: 720px;
    margin-bottom: 34px;
}

.public-section-head--compact {
    margin-bottom: 24px;
}

.public-section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.2vw, 3rem);
    line-height: 1.1;
    color: var(--color-ink);
    letter-spacing: -0.025em;
}

.public-section-head p {
    margin-top: 10px;
    color: var(--color-ink-soft);
}

.ppdb-hero-card {
    position: relative;
    padding: 26px;
    border-radius: 36px;
    background: linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.88),
        rgba(220, 241, 247, 0.82)
    );
    box-shadow: var(--shadow-card);
    overflow: hidden;
}

.ppdb-hero-card__orb {
    width: 112px;
    height: 112px;
    display: grid;
    place-items: center;
    margin-left: auto;
    border-radius: 999px;
    background: var(--color-yellow);
