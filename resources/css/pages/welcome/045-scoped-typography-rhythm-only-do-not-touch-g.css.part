.galeri-section__head .section-title,
.galeri-section__head .section-title--white,
.galeri-section .galeri-section__head .section-title--white {
    color: var(--color-ink);
    text-shadow: none;
    font-size: clamp(1.9rem, 2.2vw + 0.9rem, 3.45rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
}

.galeri-section__head .section-subtitle,
.galeri-section__head .section-subtitle--white,
.galeri-section .galeri-section__head .section-subtitle--white {
    max-width: 680px;
    margin-top: 12px;
    margin-inline: auto;
    color: rgba(31, 46, 43, 0.72);
    font-size: clamp(0.96rem, 0.28vw + 0.9rem, 1.08rem);
    line-height: 1.68;
}

/* Scoped typography rhythm only. Do not touch gallery sticky/media layout. */
.visi-misi__head .section-title,
.nilai-section__intro .section-title,
.program-section__head .section-title,
.galeri-section__head .section-title,
.galeri-section__head .section-title--white,
.galeri-section .galeri-section__head .section-title--white,
.artikel-section__head .section-title {
    font-size: clamp(1.95rem, 2.25vw + 0.95rem, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
}

.visi-misi__head .section-subtitle,
.nilai-section__intro .section-subtitle,
.program-section__head .section-subtitle,
.galeri-section__head .section-subtitle,
.galeri-section__head .section-subtitle--white,
.galeri-section .galeri-section__head .section-subtitle--white,
.artikel-section__head .section-subtitle {
    max-width: 680px;
    margin-top: 12px;
    font-size: clamp(0.98rem, 0.28vw + 0.9rem, 1.08rem);
    line-height: 1.68;
}

.visi-misi__head,
.program-section__head,
.galeri-section__head,
.artikel-section__head {
    margin-bottom: clamp(30px, 4vw, 52px);
}

.nilai-section__intro {
    margin-bottom: clamp(30px, 4vw, 52px);
}

@media (max-width: 720px) {
    .visi-misi__head .section-title,
    .nilai-section__intro .section-title,
    .program-section__head .section-title,
    .galeri-section__head .section-title,
    .galeri-section__head .section-title--white,
    .galeri-section .galeri-section__head .section-title--white,
    .artikel-section__head .section-title {
        font-size: clamp(1.85rem, 8.4vw, 2.7rem);
        line-height: 1.08;
    }

    .visi-misi__head,
    .program-section__head,
    .galeri-section__head,
    .artikel-section__head,
    .nilai-section__intro {
        margin-bottom: 30px;
    }
}

/* Halaman /artikel: clean editorial grid 3-2-1, gambar kotak 16:9, teks resmi di bawah. */
.article-index-hero {
    background: #fffaf0;
}

.article-hero-card {
    border: 0;
    background: transparent;
    box-shadow: none;
}

.article-toolbar--search-only {
    margin-top: 28px;
}

.article-search--wide {
    width: min(560px, 100%);
    border-radius: 999px;
    background: #ffffff;
    box-shadow: none;
}

.article-index-section,
.article-index-list-section {
    padding-top: clamp(42px, 5vw, 72px);
    padding-bottom: clamp(64px, 7vw, 104px);
    background: #fffaf0;
}

.article-index-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 64px) clamp(24px, 3vw, 46px);
    align-items: start;
}

.article-index-card {
    min-width: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: visible;
}

.article-index-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
}

.article-index-card__media {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    background: #f1efe9;
}

.article-index-card__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1);
    transition:
        transform 0.28s ease,
        filter 0.28s ease;
}

.article-index-card__media span {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 950;
    color: rgba(31, 31, 31, 0.34);
}

.article-index-card__overlay {
    position: static;
    display: grid;
    gap: 9px;
    padding: 15px 0 0;
    border-radius: 0;
    background: transparent;
    color: #171717;
    box-shadow: none;
    transform: none;
    backdrop-filter: none;
}

.article-index-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: rgba(31, 31, 31, 0.48);
    font-size: 0.82rem;
    font-weight: 750;
}
