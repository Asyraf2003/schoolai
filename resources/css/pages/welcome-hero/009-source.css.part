    }
}

@media (max-width: 440px) {
    .nav-shell .navbar__logo-text {
        display: none;
    }

    .hero-cinema__title {
        font-size: clamp(2.25rem, 11.2vw, 3.2rem);
    }

    .hero-cinema__description {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }
}

@media (prefers-reduced-motion: reduce) {
    .nav-shell .navbar,
    .nav-shell .navbar *,
    .hero-cinema *,
    .hero-cinema *::before,
    .hero-cinema *::after {
        animation: none !important;
        transition-duration: 0.01ms !important;
    }

    .hero-cinema__media img,
    .hero-cinema__media video,
    .hero-cinema__copy {
        transform: none !important;
        filter: none !important;
    }
}

