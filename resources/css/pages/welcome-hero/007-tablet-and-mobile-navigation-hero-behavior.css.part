    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
}

.hero-cinema__playback:hover,
.hero-cinema__playback:focus-visible {
    border-color: #f7b24b;
    color: #f7b24b;
}

.hero-cinema__playback svg {
    width: 15px;
    height: 15px;
}

.hero-cinema__play-icon,
.hero-cinema__playback.is-paused .hero-cinema__pause-icon {
    display: none;
}

.hero-cinema__playback.is-paused .hero-cinema__play-icon {
    display: block;
}

@keyframes hero-slide-enter {
    0% {
        opacity: 0;
    }

    38% {
        opacity: 0.78;
    }

    100% {
        opacity: 1;
    }
}

@keyframes hero-slide-leave {
    0% {
        opacity: 1;
    }

    45% {
        opacity: 0.56;
    }

    100% {
        opacity: 0;
    }
}

@keyframes hero-media-enter {
    0% {
        transform: scale(1.16);
        filter: blur(14px);
    }

    100% {
        transform: scale(1);
        filter: blur(0);
    }
}

@keyframes hero-media-leave {
    0% {
        transform: scale(1);
        filter: blur(0);
    }

    100% {
        transform: scale(1.13);
        filter: blur(12px);
    }
}

@keyframes hero-cinema-progress {
    from {
        transform: scaleX(0);
    }

    to {
        transform: scaleX(1);
    }
}

/* --------------------------------------------------------------------------
   Tablet and mobile navigation/hero behavior
   -------------------------------------------------------------------------- */

@media (max-width: 1180px) {
    :root {
        --hero-nav-height: 88px;
    }

    .nav-shell .navbar__menu {
        position: fixed;
        inset-block-start: calc(var(--hero-nav-height) - 4px);
        inset-inline: var(--hero-content-gutter);
        z-index: calc(var(--hero-layer-header) + 1);
        width: auto;
        max-height: calc(100dvh - var(--hero-nav-height) - 20px);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        gap: 22px;
        padding: 24px;
        overflow-y: auto;
        border: 1px solid rgb(255 255 255 / 0.74);
        border-radius: 24px;
        color: #17362f;
        background: rgb(255 250 241 / 0.98);
        -webkit-backdrop-filter: blur(20px) saturate(130%);
        backdrop-filter: blur(20px) saturate(130%);
        box-shadow: 0 28px 76px rgb(2 16 14 / 0.3);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-14px) scale(0.98);
        transform-origin: top center;
        transition:
            opacity 200ms ease,
            transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
            visibility 0s linear 280ms;
    }

    .nav-shell .navbar__menu.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0) scale(1);
        transition-delay: 0s;
    }

    .nav-shell .navbar__menu > ul {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 4px;
    }

    .nav-shell .navbar__menu > ul > li {
        width: 100%;
    }

    .nav-shell .nav-link {
        width: 100%;
        min-height: 48px;
        color: #17362f;
        font-size: 1rem;
    }

    .nav-shell .nav-link.active {
        color: #a65019;
    }

    .nav-shell .nav-mega__trigger {
        justify-content: space-between;
        padding-inline: 0;
    }

    .nav-shell .nav-mega__trigger svg {
        width: 18px;
        height: 18px;
        padding: 2px;
        border-radius: 50%;
        color: #31544c;
        background: #f3eadb;
    }

    .nav-shell .nav-mega__panel {
        position: static;
        width: 100%;
        min-height: 0;
        max-height: 0;
        display: grid;
        grid-template-columns: 1fr;
        margin: 0;
        overflow: hidden;
