
.hero-cinema__slide.is-entering .hero-cinema__media img,
.hero-cinema__slide.is-entering .hero-cinema__media video {
    animation: hero-media-enter 1060ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero-cinema__slide.is-leaving .hero-cinema__media img,
.hero-cinema__slide.is-leaving .hero-cinema__media video {
    animation: hero-media-leave 1060ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero-cinema__media::after {
    content: "";
    z-index: var(--hero-layer-overlay);
    pointer-events: none;
    background:
        linear-gradient(
            to top,
            rgb(2 13 12 / 0.96) 0%,
            rgb(2 13 12 / 0.7) 34%,
            rgb(2 13 12 / 0.12) 72%
        ),
        linear-gradient(
            to right,
            rgb(3 20 17 / 0.68) 0%,
            rgb(3 20 17 / 0.16) 58%,
            transparent 84%
        ),
        rgb(2 13 12 / var(--hero-overlay-strength));
}

html[dir="rtl"] .hero-cinema__media::after {
    background:
        linear-gradient(
            to top,
            rgb(2 13 12 / 0.96) 0%,
            rgb(2 13 12 / 0.7) 34%,
            rgb(2 13 12 / 0.12) 72%
        ),
        linear-gradient(
            to left,
            rgb(3 20 17 / 0.68) 0%,
            rgb(3 20 17 / 0.16) 58%,
            transparent 84%
        ),
        rgb(2 13 12 / var(--hero-overlay-strength));
}

.hero-cinema__ornaments {
    position: absolute;
    inset: 0;
    z-index: calc(var(--hero-layer-content) - 1);
    overflow: hidden;
    color: #f3c877;
    pointer-events: none;
}

.hero-cinema__ornament {
    position: absolute;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    vector-effect: non-scaling-stroke;
}

.hero-cinema__ornament--lattice {
    inset-block-start: -38px;
    inset-inline-end: -72px;
    width: clamp(250px, 24vw, 420px);
    height: min(74vh, 690px);
    opacity: 0.16;
    transform: rotate(-8deg);
}

.hero-cinema__ornament--rosette {
    inset-inline-end: clamp(30px, 7vw, 140px);
    inset-block-end: clamp(70px, 10vh, 130px);
    width: clamp(120px, 13vw, 230px);
    opacity: 0.22;
    stroke-width: 1.35;
    transform: rotate(7deg);
}

.hero-cinema__ornament--corner {
    inset-inline-end: -34px;
    inset-block-end: -8px;
    width: clamp(300px, 34vw, 620px);
    opacity: 0.22;
    stroke-width: 1.3;
}

html[dir="rtl"] .hero-cinema__ornament--lattice {
    transform: scaleX(-1) rotate(-8deg);
}

html[dir="rtl"] .hero-cinema__ornament--rosette {
    transform: scaleX(-1) rotate(7deg);
}

html[dir="rtl"] .hero-cinema__ornament--corner {
    transform: scaleX(-1);
}

.hero-cinema__content {
    position: relative;
    z-index: var(--hero-layer-content);
    width: 100%;
    max-width: none;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    margin-inline: 0;
    padding-inline: var(--hero-content-gutter);
    padding-block-start: calc(var(--hero-nav-height) + 54px);
    padding-block-end: clamp(132px, 17vh, 196px);
}

.hero-cinema__copy {
    width: min(940px, 78vw);
    opacity: 0;
    transform: translateY(34px);
    transition:
        opacity 650ms ease 180ms,
        transform 760ms cubic-bezier(0.22, 1, 0.36, 1) 180ms;
}

.hero-cinema__slide.is-active .hero-cinema__copy {
    opacity: 1;
    transform: translateY(0);
}

.hero-cinema__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #f8c56d;
    font-size: clamp(0.68rem, 0.9vw, 0.8rem);
    font-weight: 850;
    letter-spacing: 0.2em;
    text-transform: uppercase;
}

.hero-cinema__eyebrow::before {
    content: "";
    width: 42px;
    height: 1px;
    background: currentColor;
}

.hero-cinema__title {
    max-width: 15ch;
    margin-block-start: clamp(14px, 2vh, 24px);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6.9rem);
    font-weight: 760;
    line-height: 0.94;
    letter-spacing: -0.055em;
    text-wrap: balance;
    text-shadow: 0 8px 34px rgb(0 0 0 / 0.28);
}

.hero-cinema__description {
    max-width: 62ch;
    margin-block-start: clamp(20px, 3vh, 30px);
    color: rgb(255 255 255 / 0.82);
    font-size: clamp(0.98rem, 1.2vw, 1.16rem);
    line-height: 1.68;
    text-shadow: 0 3px 18px rgb(0 0 0 / 0.28);
}

.hero-cinema__cta {
    position: relative;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-block-start: clamp(28px, 4vh, 42px);
