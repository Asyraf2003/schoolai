.nav-shell .nav-mega__intro {
    position: relative;
    min-height: 330px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(28px, 3vw, 44px);
    overflow: hidden;
    color: #ffffff;
    background:
        radial-gradient(circle at 15% 5%, rgb(247 178 75 / 0.42), transparent 42%),
        linear-gradient(145deg, #174f42 0%, #0b2e28 100%);
}

.nav-shell .nav-mega__intro::after {
    content: "";
    position: absolute;
    inset: 20px -44px auto auto;
    width: 170px;
    aspect-ratio: 1;
    border: 1px solid rgb(247 198 111 / 0.18);
    border-radius: 28% 72% 36% 64%;
    transform: rotate(22deg);
    box-shadow:
        0 0 0 18px rgb(247 198 111 / 0.05),
        0 0 0 42px rgb(247 198 111 / 0.035);
}

html[dir="rtl"] .nav-shell .nav-mega__intro::after {
    inset-inline: -44px auto;
}

.nav-shell .nav-mega__eyebrow {
    position: relative;
    z-index: 1;
    color: #f7c66f;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.nav-shell .nav-mega__title {
    position: relative;
    z-index: 1;
    margin-block-start: 12px;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.16;
    letter-spacing: -0.025em;
}

.nav-shell .nav-mega__description {
    position: relative;
    z-index: 1;
    margin-block-start: 12px;
    color: rgb(255 255 255 / 0.72);
    font-size: 0.85rem;
    line-height: 1.6;
}

.nav-shell .nav-mega__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    align-content: center;
    padding: clamp(24px, 3vw, 38px);
}

.nav-shell .nav-mega__link {
    min-width: 0;
    display: grid;
    gap: 4px;
    padding: 16px;
    border: 1px solid rgb(23 79 66 / 0.1);
    border-radius: 16px;
    background: #ffffff;
    transition:
        transform 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease;
}

.nav-shell .nav-mega__link:hover,
.nav-shell .nav-mega__link:focus-visible {
    border-color: rgb(184 90 31 / 0.3);
    box-shadow: 0 14px 28px rgb(15 54 47 / 0.09);
    transform: translateY(-2px);
}

.nav-shell .nav-mega__link strong {
    color: #183c34;
    font-size: 0.9rem;
    line-height: 1.3;
}

.nav-shell .nav-mega__link small {
    color: #6b7d78;
    font-size: 0.72rem;
    line-height: 1.45;
}
.nav-shell .nav-language {
    position: relative;
}

.nav-shell .nav-language__button {
    border: 0;
    background: transparent;
}

.nav-shell .nav-language__current-flag {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    overflow: hidden;
    border: 2px solid rgb(255 255 255 / 0.72);
    border-radius: 50%;
    box-shadow: 0 5px 12px rgb(0 0 0 / 0.14);
}

.nav-shell .navbar.is-scrolled .nav-language__current-flag,
.nav-shell .navbar.has-open-menu .nav-language__current-flag {
    border-color: rgb(23 79 66 / 0.16);
}

.nav-shell .nav-language__panel {
    position: absolute;
    inset-block-start: calc(100% + 10px);
    inset-inline-end: 0;
    z-index: var(--hero-layer-menu);
    min-width: max-content;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 2px;
    border: 0;
    color: #172c28;
    background: transparent;
    box-shadow: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px) scale(0.92);
    transform-origin: top center;
    transition:
        opacity 160ms ease,
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 220ms;
}

.nav-shell .nav-language.is-open .nav-language__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition-delay: 0s;
}

.nav-shell .nav-language__form {
    margin: 0;
}

.nav-shell .nav-language__option {
    width: 52px;
    height: 52px;
    min-height: 52px;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 0;
    border: 3px solid rgb(255 255 255 / 0.9);
    border-radius: 50%;
    color: #28443e;
    background: transparent;
    box-shadow:
        0 8px 24px rgb(3 18 16 / 0.24),
        0 0 0 1px rgb(4 29 24 / 0.06);
    transition:
        transform 180ms ease,
        border-color 180ms ease,
