body.admin-desktop-body .gallery-media-review {
    padding: 16px;
}

body.admin-desktop-body .admin-field {
    gap: 5px;
}

body.admin-desktop-body .admin-field label,
body.admin-desktop-body .admin-check-field {
    font-size: 0.84rem;
}

body.admin-desktop-body .admin-field input,
body.admin-desktop-body .admin-field select,
