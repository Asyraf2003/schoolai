    padding: 9px 12px;
}

body.admin-desktop-body .ppdb-showcase-row__order {
    width: 30px;
    height: 30px;
    font-size: 0.78rem;
}

body.admin-desktop-body .ppdb-showcase-row__body strong {
    font-size: 0.88rem;
}

body.admin-desktop-body .ppdb-showcase-row__body small {
