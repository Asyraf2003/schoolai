    background: #fff;
    overflow: hidden;
}

body.admin-desktop-body .admin-stat-create > summary,
body.admin-desktop-body .admin-stat-record > summary {
    list-style: none;
    cursor: pointer;
}

body.admin-desktop-body .admin-stat-create > summary::-webkit-details-marker,
body.admin-desktop-body .admin-stat-record > summary::-webkit-details-marker {
