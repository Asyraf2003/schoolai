.canvas-unsplash-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.canvas-unsplash-grid button { min-height: 150px; padding: 0; border: 0; border-radius: 5px; background: #eee; overflow: hidden; cursor: pointer; }
.canvas-unsplash-grid img { width: 100%; height: 100%; min-height: 150px; display: block; object-fit: cover; }

.canvas-publish-drawer { display: flex; justify-content: flex-end; }
.canvas-publish-drawer__panel {
  position: relative;
  z-index: 1;
  width: min(100%, 460px);
  height: 100%;
  padding: 38px 32px;
  background: #fff;
  overflow-y: auto;
  box-shadow: -18px 0 50px rgba(0, 0, 0, .14);
}

.canvas-publish-drawer__close { position: absolute; top: 18px; right: 20px; border: 0; background: transparent; color: var(--canvas-muted); font-size: 1.7rem; cursor: pointer; }
.canvas-preview-card { display: grid; gap: 8px; margin: 24px 0; padding-bottom: 22px; border-bottom: 1px solid var(--canvas-line); }
.canvas-preview-card__image { position: relative; aspect-ratio: 16 / 9; background: #eee; overflow: hidden; }
.canvas-preview-card__image img { width: 100%; height: 100%; display: block; object-fit: cover; }
.canvas-preview-card__image button {
  position: absolute;
  right: 10px;
  bottom: 10px;
  padding: 7px 11px;
  border: 0;
  border-radius: 999px;
  background: rgba(36, 36, 36, .88);
  color: #fff;
  cursor: pointer;
  font-size: .75rem;
}
.canvas-preview-card strong { font-family: var(--canvas-story); font-size: 1.3rem; line-height: 1.25; }
.canvas-preview-card span { color: var(--canvas-muted); font-size: .9rem; }
.canvas-preview-card__meta { display: flex; flex-wrap: wrap; gap: 6px; color: var(--canvas-muted); font-size: .78rem; }
.canvas-preview-card__meta > * + *::before { content: "·"; margin-right: 6px; }
.canvas-publish-field { display: grid; gap: 8px; margin-top: 18px; }
.canvas-publish-field > span,
.canvas-publish-schedule legend { font-weight: 650; }
.canvas-publish-field small { color: var(--canvas-muted); font-weight: 400; }
.canvas-publish-schedule { display: grid; gap: 11px; margin: 24px 0; padding: 18px; border: 1px solid var(--canvas-line); border-radius: 8px; }
.canvas-publish-schedule label { display: flex; align-items: center; gap: 8px; }
.canvas-publish-schedule .canvas-publish-date { display: grid; gap: 7px; margin-top: 5px; color: var(--canvas-muted); font-size: .8rem; }
.canvas-category-editor { position: relative; }
.canvas-category-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 7px; }
.canvas-category-chips:empty { display: none; }
.canvas-category-chips > span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px 6px 10px;
  border-radius: 999px;
  background: #f0f0f0;
  font-size: .78rem;
}
.canvas-category-chips button { width: 18px; height: 18px; padding: 0; border: 0; border-radius: 50%; background: #d8d8d8; cursor: pointer; line-height: 1; }
.canvas-category-suggestions {
  position: absolute;
  z-index: 5;
  top: calc(100% + 5px);
  left: 0;
  right: 0;
  display: grid;
  max-height: 190px;
  padding: 6px;
  border: 1px solid var(--canvas-line);
  border-radius: 8px;
  background: #fff;
  box-shadow: 0 12px 32px rgba(0, 0, 0, .14);
  overflow-y: auto;
}
.canvas-category-suggestions button { padding: 9px 10px; border: 0; border-radius: 5px; background: transparent; text-align: left; cursor: pointer; }
.canvas-category-suggestions button:hover,
.canvas-category-suggestions button:focus-visible { background: #f2f2f2; outline: 0; }
.canvas-publish-submit { width: 100%; min-height: 46px; }
.canvas-publish-submit:disabled { opacity: .55; cursor: wait; }

@media (max-width: 850px) {
  .canvas-topbar { padding: 0 16px; }
  .canvas-divider,
  .canvas-count { display: none; }
  .canvas-workspace { padding: 38px 22px 120px; }
  .canvas-block-menu { position: fixed; left: 14px; bottom: 18px; top: auto !important; padding: 6px; border-radius: 999px; background: #fff; box-shadow: 0 8px 30px rgba(0,0,0,.14); }
  .canvas-block-actions { position: absolute; left: 0; bottom: 50px; width: min(312px, calc(100vw - 28px)); max-height: min(70vh, 540px); overflow-y: auto; }
  .canvas-body figure.article-image--outset { width: calc(100vw - 28px); }
  .canvas-body figure.article-image--compact { width: min(82%, 500px); }
  .canvas-unsplash-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 520px) {
  .canvas-save-state { max-width: 90px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .canvas-language-switch { display: none; }
  .canvas-title { font-size: 2.4rem; }
  .canvas-body { font-size: 1.15rem; }
  .canvas-unsplash-grid { grid-template-columns: 1fr; }
  .canvas-publish-drawer__panel { padding: 38px 22px; }
}
