.native-article {
  --reader-ink: #242424;
  --reader-muted: #6b6b6b;
  --reader-line: #e6e6e6;
  --reader-serif: Charter, "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
  width: 100%;
  padding: clamp(52px, 8vw, 92px) 22px 110px;
  color: var(--reader-ink);
  background: #fff;
}

.native-article__header,
.native-article__body,
.native-article__footer {
  width: min(100%, 680px);
  margin-inline: auto;
}

.native-article__preview-banner {
  position: sticky;
  top: 12px;
  z-index: 5;
  width: min(100%, 680px);
  display: flex;
  flex-wrap: wrap;
  gap: 6px 10px;
  margin: 0 auto 28px;
  padding: 11px 14px;
  border: 1px solid #f0cf72;
  border-radius: 8px;
  background: #fff8d8;
  color: #684d00;
  font-family: ui-sans-serif, system-ui, sans-serif;
  font-size: .82rem;
  box-shadow: 0 8px 24px rgba(104, 77, 0, .1);
}

.native-article__preview-banner strong { flex: 0 0 auto; }

.native-article__back {
  display: inline-flex;
  margin-bottom: 32px;
  color: var(--reader-muted);
  font-size: .9rem;
  text-decoration: none;
}

.native-article__back:hover { color: var(--reader-ink); }

.native-article__header h1 {
  margin: 0;
  font-family: var(--reader-serif);
  font-size: clamp(2.7rem, 7vw, 4.15rem);
  font-weight: 750;
  line-height: 1.06;
  letter-spacing: -.045em;
}

.native-article__subtitle {
  margin: 18px 0 0;
  color: var(--reader-muted);
  font-family: var(--reader-serif);
  font-size: clamp(1.25rem, 3vw, 1.55rem);
  line-height: 1.45;
}

.native-article__byline {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 28px;
}

.native-article__avatar {
  flex: 0 0 auto;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #20223f;
  color: #fff;
  font-weight: 800;
}

.native-article__byline strong,
.native-article__byline small { display: block; }
.native-article__byline strong { font-size: .92rem; }
.native-article__byline small { margin-top: 3px; color: var(--reader-muted); font-size: .82rem; }

.native-article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin: 24px 0 0;
  padding: 0;
  list-style: none;
}

.native-article__tags a {
  display: block;
  padding: 7px 11px;
  border-radius: 999px;
  background: #f2f2f2;
  color: #555;
  font-size: .78rem;
  text-decoration: none;
}

.native-article__tags a:hover,
.native-article__tags a:focus-visible { background: #e5e5e5; color: var(--reader-ink); outline: 0; }

.native-article__body {
  margin-top: 52px;
  font-family: var(--reader-serif);
  font-size: clamp(1.13rem, 2.1vw, 1.3rem);
  line-height: 1.72;
  letter-spacing: -.004em;
  overflow-wrap: anywhere;
}

.native-article__body p,
.native-article__body h2,
.native-article__body h3,
.native-article__body blockquote,
.native-article__body pre,
.native-article__body ul,
.native-article__body ol,
.native-article__body figure,
.native-article__body .article-embed,
.native-article__body .article-video { margin: 0 0 1.35em; }

.native-article__body h2 {
  margin-top: 1.8em;
  font-size: 1.75em;
  line-height: 1.2;
  letter-spacing: -.025em;
}

.native-article__body h3 {
  margin-top: 1.7em;
  font-size: 1.3em;
  line-height: 1.28;
}

.native-article__body a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
.native-article__body li { margin-bottom: .38em; padding-left: .2em; }
.native-article__body mark { padding: .03em .12em; border-radius: 3px; background: #fff3a3; color: inherit; }
.native-article__body code { padding: .12em .3em; border-radius: 4px; background: #f2f2f2; font: .84em ui-monospace, SFMono-Regular, Menlo, monospace; }
.native-article__body .article-text-small { font-size: .86em; line-height: 1.65; }
.native-article__body .article-text-large { font-size: 1.22em; line-height: 1.55; }
.native-article__body .article-align-center { text-align: center; }
.native-article__body .article-align-right { text-align: right; }
.native-article__body .article-align-justify { text-align: justify; text-justify: inter-word; }
.native-article__body .article-color--default { color: inherit; }
.native-article__body .article-color--muted { color: #6b6b6b; }
.native-article__body .article-color--green { color: #166534; }
.native-article__body .article-color--blue { color: #1d4ed8; }
.native-article__body .article-color--red { color: #b42318; }
.native-article__body .article-color--amber { color: #a15c00; }

.native-article__body .article-bg--gray,
.native-article__body .article-bg--yellow,
.native-article__body .article-bg--green,
.native-article__body .article-bg--blue,
.native-article__body .article-bg--rose {
  padding: .42em .62em;
  border-radius: 7px;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

.native-article__body .article-bg--gray { background: #f2f2f2; }
.native-article__body .article-bg--yellow { background: #fff6bf; }
.native-article__body .article-bg--green { background: #dcfce7; }
.native-article__body .article-bg--blue { background: #dbeafe; }
.native-article__body .article-bg--rose { background: #ffe4e6; }

.native-article__body pre {
  width: min(900px, calc(100vw - 32px));
