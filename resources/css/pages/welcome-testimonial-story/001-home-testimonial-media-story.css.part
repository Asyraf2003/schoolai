/* ========================================================================== 
   HOME — TESTIMONIAL MEDIA STORY
   Full-screen video contracts into a centered frame while the title rises
   out of the video. Testimonial media then appears one by one around it.
   ========================================================================== */

.testimonial-network-story {
    --testimonial-media-width: 100vw;
    --testimonial-media-height: 100svh;
    --testimonial-media-radius: 0px;
    --testimonial-title-top: 72svh;
    --testimonial-title-scale: 1;
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #11110f;
    color: #f4f1e9;
}

.testimonial-network-story *,
.testimonial-network-story *::before,
.testimonial-network-story *::after,
.testimonial-media-modal *,
.testimonial-media-modal *::before,
.testimonial-media-modal *::after {
    box-sizing: border-box;
}

.testimonial-network-story__track,
.testimonial-network-story__sticky {
    position: relative;
}

.testimonial-network-story__stage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
        radial-gradient(circle at 13% 18%, rgb(255 188 91 / 0.08), transparent 28rem),
        radial-gradient(circle at 86% 78%, rgb(111 161 255 / 0.08), transparent 30rem),
        #11110f;
}

.testimonial-network-story__stage::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 16%, rgb(255 255 255 / 0.025), transparent 68%);
}

.testimonial-network-story__main-media {
    position: absolute;
    z-index: 5;
    width: var(--testimonial-media-width);
    height: var(--testimonial-media-height);
    left: 50%;
    top: 50%;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--testimonial-media-radius);
    background: #080808;
    box-shadow:
        0 34px 92px rgb(0 0 0 / 0.34),
        0 1px 0 rgb(255 255 255 / 0.14) inset;
    transform: translate3d(-50%, -50%, 0);
    transform-origin: center;
    cursor: zoom-in;
    will-change: width, height, border-radius;
}

.testimonial-network-story__main-media video,
.testimonial-network-story__main-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.testimonial-network-story__main-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
        linear-gradient(180deg, rgb(0 0 0 / 0.03), transparent 42%, rgb(0 0 0 / 0.52)),
        linear-gradient(90deg, rgb(0 0 0 / 0.12), transparent 52%, rgb(0 0 0 / 0.08));
}

.testimonial-network-story__title-wrap {
    position: absolute;
    z-index: 9;
    width: min(90vw, 1240px);
    left: 50%;
    top: var(--testimonial-title-top);
    text-align: center;
    transform: translate3d(-50%, -50%, 0) scale(var(--testimonial-title-scale));
    transform-origin: center;
    pointer-events: none;
    will-change: top, transform;
}

.testimonial-network-story__title {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 6.4vw, 7.4rem);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: -0.065em;
    text-wrap: balance;
    text-shadow: 0 12px 38px rgb(0 0 0 / 0.42);
}

[dir="rtl"] .testimonial-network-story__title {
    letter-spacing: 0;
    line-height: 1.05;
}

.testimonial-network-story__nodes {
    position: absolute;
    z-index: 8;
    inset: 0;
    pointer-events: none;
}

.testimonial-network-story__node {
    --node-opacity: 0;
    --node-y: 34px;
    --node-scale: 0.82;
    position: absolute;
    width: clamp(92px, 8.7vw, 158px);
    aspect-ratio: 4 / 3;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    opacity: var(--node-opacity);
    transform: translate3d(0, var(--node-y), 0) scale(var(--node-scale));
    transform-origin: center;
    pointer-events: auto;
    cursor: zoom-in;
    will-change: transform, opacity;
}

.testimonial-network-story__node:nth-child(2n) {
    width: clamp(84px, 7.8vw, 144px);
}

.testimonial-network-story__node:nth-child(3n) {
    aspect-ratio: 1 / 1;
}

.testimonial-network-story__node-media {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: clamp(8px, 0.8vw, 14px);
    background: #24241f;
    box-shadow: 0 16px 42px rgb(0 0 0 / 0.32);
    animation: testimonial-node-float 5.8s ease-in-out infinite;
}

.testimonial-network-story__node:nth-child(2n) .testimonial-network-story__node-media {
    animation-delay: -1.7s;
    animation-duration: 6.6s;
}

.testimonial-network-story__node:nth-child(3n) .testimonial-network-story__node-media {
    animation-delay: -3.1s;
    animation-duration: 7.2s;
}

.testimonial-network-story__node img {
    width: 100%;
    height: 100%;
