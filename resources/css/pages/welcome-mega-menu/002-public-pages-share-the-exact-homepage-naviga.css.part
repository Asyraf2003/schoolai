/* Public pages share the exact homepage navigation shell. The header and an
 * opened mega panel use one continuous surface so there is no color seam. */
.public-content-page.nav-shell {
    background:
        radial-gradient(circle at 8% 12%, rgb(255 201 60 / 0.24), transparent 28%),
        radial-gradient(circle at 92% 0%, rgb(127 199 224 / 0.24), transparent 30%),
        var(--color-cream);
}

.public-content-page.nav-shell .navbar,
.public-content-page.nav-shell .navbar.is-scrolled,
.public-content-page.nav-shell .navbar.has-open-menu {
    min-height: 78px;
    height: 78px;
    color: #172c28;
    background: var(--nav-mega-surface);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: 0 10px 30px rgb(7 27 24 / 0.08);
}

.public-content-page.nav-shell .navbar.has-open-menu {
    box-shadow: none;
}

.public-content-page.nav-shell .navbar__logo-icon {
    width: 54px;
    height: 54px;
    flex-basis: 54px;
    border-color: rgb(19 122 76 / 0.12);
    box-shadow:
        0 0 0 6px rgb(255 255 255 / 0.5),
        0 10px 26px rgb(7 27 24 / 0.13);
}

.public-content-page.nav-shell .nav-link.active {
    color: #aa541a;
}

.public-content-page.nav-shell .navbar__cta {
    color: #fff;
    border-color: #a64f18;
    background: #b85a1f;
}

.public-content-page.nav-shell .nav-language__current-flag {
    border-color: rgb(23 79 66 / 0.16);
}

@media (min-width: 1181px) {
    .public-content-page.nav-shell .nav-mega__panel {
        inset-block-start: 77px;
        background: var(--nav-mega-surface);
    }
}

@media (max-width: 1180px) {
    .nav-shell .nav-overlay {
        display: none !important;
    }

    .nav-shell .navbar__menu {
        position: fixed;
        inset: 0;
        z-index: calc(var(--hero-layer-header) - 1);
        width: 100vw;
        height: 100dvh;
        max-height: none;
        display: block;
        padding: calc(var(--hero-nav-height) + 22px) clamp(20px, 5vw, 42px) 34px;
        overflow-y: auto;
        border: 0;
        border-radius: 0;
        color: #17362f;
        background: #fffaf1;
        box-shadow: none;
        opacity: 1;
        visibility: hidden;
        pointer-events: none;
        transform: translateX(100%);
        transform-origin: center;
        transition:
            transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
            visibility 0s linear 320ms;
    }

    html[dir="rtl"] .nav-shell .navbar__menu {
        transform: translateX(-100%);
    }

    .nav-shell .navbar__menu.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(0);
        transition-delay: 0s;
    }

    html[dir="rtl"] .nav-shell .navbar__menu.active {
        transform: translateX(0);
    }

    .nav-shell .navbar__menu > ul {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
    }

    .nav-shell .navbar__menu > ul > li {
        width: 100%;
    }

    .nav-shell .nav-link {
        width: 100%;
        min-height: 54px;
        justify-content: flex-start;
        padding: 13px 0;
        border-block-end: 1px solid rgb(23 79 66 / 0.1);
        color: #17362f;
        font-size: clamp(1rem, 3.8vw, 1.12rem);
        font-weight: 780;
    }

    .nav-shell .nav-link::after {
        display: none;
    }

    .nav-shell .nav-link.active {
        color: #b85a1f;
    }

    .nav-shell .nav-mega__trigger {
        justify-content: space-between;
        padding-inline: 0;
    }

    .nav-shell .nav-mega__trigger svg {
        width: 18px;
        height: 18px;
        padding: 0;
        border-radius: 0;
        color: #31544c;
        background: transparent;
    }

    .nav-shell .nav-mega__panel {
        position: static;
        width: 100%;
        min-height: 0;
        max-height: 0;
        display: block;
        margin: 0;
        padding: 0;
        overflow: hidden;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        opacity: 1;
        visibility: visible;
        pointer-events: none;
        transform: none;
        clip-path: none;
        transition: max-height 280ms ease;
    }

    .nav-shell .nav-mega.is-open .nav-mega__panel {
        max-height: 420px;
        margin: 0;
        pointer-events: auto;
        transform: none;
        clip-path: none;
    }

    .nav-shell .nav-mega__media,
    .nav-shell .nav-mega__intro {
        display: none;
    }
