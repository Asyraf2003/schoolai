
    .nav-shell .nav-mega__links {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        padding: 4px 0 10px clamp(14px, 4vw, 26px);
        background: transparent;
    }

    html[dir="rtl"] .nav-shell .nav-mega__links {
        padding: 4px clamp(14px, 4vw, 26px) 10px 0;
    }

    .nav-shell .nav-mega__link {
        min-height: 0;
        display: block;
        padding: 10px 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        transform: none;
    }

    .nav-shell .nav-mega__link:hover,
    .nav-shell .nav-mega__link:focus-visible {
        color: #b85a1f;
        border: 0;
        box-shadow: none;
        transform: none;
    }

    .nav-shell .nav-mega__link strong {
        color: #31544c;
        font-size: 0.9rem;
        font-weight: 720;
    }

    .nav-shell .nav-mega__link small {
        display: none;
    }

    .nav-shell .nav-language {
        width: 100%;
        margin-block-start: 0;
        padding-block-start: 0;
        border-block-start: 0;
    }

    .nav-shell .nav-language__button {
        justify-content: flex-start;
        color: #17362f;
    }

    .nav-shell .navbar__cta {
        width: 100%;
        margin-block-start: 24px;
        min-height: 52px;
        color: #ffffff;
        border-color: #a64f18;
        background: #b85a1f;
    }
}
