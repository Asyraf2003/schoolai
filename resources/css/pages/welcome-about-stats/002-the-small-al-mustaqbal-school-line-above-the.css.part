    background-position: 0% 0%, 100% 0%, 0% 100%, 100% 100%, center;
    box-shadow:
        0 1px 0 rgb(255 255 255 / 0.95) inset,
        0 28px 78px rgb(17 58 51 / 0.1),
        -18px 18px 54px rgb(255 104 66 / 0.055),
        18px -18px 54px rgb(83 135 255 / 0.055);
    text-align: center;
    backdrop-filter: blur(20px) saturate(112%);
    -webkit-backdrop-filter: blur(20px) saturate(112%);
    animation: about-card-rainbow-breathe 16s ease-in-out infinite alternate;
}

.about-stats-story__intro::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
        120deg,
        rgb(255 104 66 / 0.52),
        rgb(255 200 61 / 0.38),
        rgb(22 173 136 / 0.44),
        rgb(83 135 255 / 0.43),
        rgb(139 102 239 / 0.44),
        rgb(255 104 66 / 0.52)
    );
    background-size: 230% 100%;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    animation: about-border-rainbow-flow 13s linear infinite;
}

.about-stats-story__intro::after {
    content: "";
    position: absolute;
    width: clamp(76px, 8vw, 122px);
    height: 3px;
    left: 50%;
    bottom: -2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--story-orange), var(--story-yellow), var(--story-green), var(--story-blue), var(--story-violet));
    background-size: 180% 100%;
    transform: translateX(-50%);
    box-shadow: 0 0 24px rgb(83 135 255 / 0.18);
    animation: about-border-rainbow-flow 8s linear infinite;
}

/* The small AL MUSTAQBAL SCHOOL line above the title is intentionally removed. */
.about-stats-story__kicker {
    display: none;
}

.about-stats-story__title {
    margin: 0;
    color: var(--story-ink);
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.8vw, 5.8rem);
    font-weight: 930;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-transform: lowercase;
    text-wrap: balance;
}

.about-stats-story__description {
    max-width: 700px;
    margin: clamp(22px, 2.8vw, 34px) auto 0;
    color: var(--story-ink-soft);
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.48vw + 0.86rem, 1.23rem);
    font-weight: 580;
    line-height: 1.72;
    text-wrap: pretty;
}

[dir="rtl"] .about-stats-story__title {
    font-size: clamp(2.9rem, 4.4vw, 5.25rem);
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: none;
}

/* Statistics fallback layout. */
.about-stats-story__stats {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(56px, 8vw, 108px);
    margin: 0;
    padding: 0;
    list-style: none;
}

.about-stats-story__stat {
    --stat-opacity: 1;
    --stat-x: 0px;
    --stat-y: 0px;
    --stat-scale: 1;
    --stat-blur: 0px;
    --stat-settle: 0;
    min-width: 0;
}

.about-stats-story__stat-callout {
    position: relative;
    width: min(100%, 580px);
    margin-inline: auto;
    text-align: center;
    transform: translate3d(0, calc(var(--stat-settle) * -7px), 0) scale(calc(1 + var(--stat-settle) * 0.012));
    transform-origin: center;
    transition: filter 180ms linear;
}

.about-stats-story__stat-callout::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: min(76%, 360px);
    aspect-ratio: 1.8;
    left: 50%;
    top: 48%;
    border-radius: 50%;
    background: radial-gradient(ellipse, color-mix(in srgb, var(--stat-accent, var(--story-blue)) 20%, transparent), transparent 70%);
    filter: blur(24px);
    opacity: calc(0.12 + var(--stat-settle) * 0.5);
    transform: translate(-50%, -50%) scale(calc(0.92 + var(--stat-settle) * 0.12));
    pointer-events: none;
}

@supports not (background: color-mix(in srgb, red 20%, transparent)) {
    .about-stats-story__stat-callout::before {
        background: radial-gradient(ellipse, rgb(83 135 255 / 0.15), transparent 70%);
    }
}

.about-stats-story__stat-index {
    display: inline-block;
    margin-block-end: 9px;
    color: rgb(17 58 51 / 0.42);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.15em;
}

.about-stats-story__number {
    display: inline-block;
    margin: 0;
    color: var(--story-orange);
    font-family: var(--font-display);
    font-size: clamp(4.6rem, 9vw, 8.6rem);
    font-variant-numeric: tabular-nums;
    font-weight: 950;
    line-height: 0.9;
    letter-spacing: -0.065em;
    white-space: nowrap;
}

@supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .about-stats-story__number {
        color: transparent;
        background: linear-gradient(100deg, #ff5f45 0%, #ffca3a 24%, #19b88f 48%, #4c86ff 72%, #9167f1 100%);
        background-size: 220% 100%;
        background-position: 0% 50%;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 14px 28px rgb(83 135 255 / 0.1));
        animation: about-stat-rainbow 10s ease-in-out infinite alternate;
    }
}

.about-stats-story__label {
    margin: clamp(14px, 1.6vw, 20px) 0 0;
    color: var(--story-ink);
    font-family: var(--font-display);
