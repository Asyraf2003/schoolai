/* Page CSS: dashboard umum dan dashboard admin. */
.dashboard-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: var(--color-blue-50);
}

.dashboard-page main {
    width: min(100%, var(--container-md));
    padding: 32px;
    border-radius: var(--radius-lg);
    background: #ffffff;
    box-shadow: var(--shadow-soft);
}

body.admin-desktop-body .admin-dashboard {
    display: grid;
    gap: 14px;
}

body.admin-desktop-body .admin-dashboard__metrics {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
}

body.admin-desktop-body .admin-dashboard-metric {
    min-width: 0;
    display: grid;
    gap: 6px;
    min-height: 132px;
    padding: 15px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #ffffff;
    color: #111827;
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
}

body.admin-desktop-body .admin-dashboard-metric:hover {
    border-color: #cbd5e1;
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
}

body.admin-desktop-body .admin-dashboard-metric__label {
    color: #6b7280;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.015em;
}

body.admin-desktop-body .admin-dashboard-metric strong {
    align-self: end;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.045em;
}

body.admin-desktop-body .admin-dashboard-metric small {
    overflow: hidden;
    color: #6b7280;
    font-size: 0.73rem;
    line-height: 1.4;
    text-overflow: ellipsis;
}

body.admin-desktop-body .admin-dashboard-metric.is-positive strong {
    color: #166534;
}

body.admin-desktop-body .admin-dashboard-metric.is-muted strong {
    color: #6b7280;
}

body.admin-desktop-body .admin-dashboard__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(340px, 0.7fr);
    gap: 14px;
    align-items: start;
}

body.admin-desktop-body .admin-dashboard-panel {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #ffffff;
}

body.admin-desktop-body .admin-dashboard-panel__head {
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
    border-bottom: 1px solid #e5e7eb;
}

body.admin-desktop-body .admin-dashboard-panel__head h2 {
    margin: 0;
    color: #111827;
    font-size: 0.98rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
}

body.admin-desktop-body .admin-dashboard-table {
    display: grid;
}

body.admin-desktop-body .admin-dashboard-table__head,
body.admin-desktop-body .admin-dashboard-table__row {
    display: grid;
    grid-template-columns: minmax(170px, 1fr) 72px 122px 72px 72px;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
}

body.admin-desktop-body .admin-dashboard-table__head {
    min-height: 38px;
    background: #f9fafb;
    color: #6b7280;
    font-size: 0.72rem;
    font-weight: 800;
}

body.admin-desktop-body .admin-dashboard-table__row {
    min-height: 50px;
    border-top: 1px solid #eef0f3;
}

body.admin-desktop-body .admin-dashboard-table__row strong {
    min-width: 0;
    overflow: hidden;
    font-size: 0.87rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

body.admin-desktop-body .admin-dashboard-number {
    justify-self: start;
    min-width: 32px;
    padding: 4px 7px;
    border-radius: 999px;
    background: #f3f4f6;
    color: #4b5563;
    font-size: 0.75rem;
    font-weight: 850;
    text-align: center;
}

body.admin-desktop-body .admin-dashboard-number.is-active {
    background: #dcfce7;
    color: #166534;
}

body.admin-desktop-body .admin-dashboard-number.is-archive {
    background: #fef2f2;
    color: #991b1b;
}

body.admin-desktop-body .admin-dashboard-activity {
    display: grid;
}

body.admin-desktop-body .admin-dashboard-activity__item {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 58px;
    padding: 10px 14px;
    border-bottom: 1px solid #eef0f3;
