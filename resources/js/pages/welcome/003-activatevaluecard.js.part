    card.addEventListener('focus', function () {
      activateValueCard(card);
    });

    card.addEventListener('mouseenter', function () {
      if (window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        activateValueCard(card);
      }
    });
  });
});


