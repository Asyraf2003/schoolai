<?php

declare(strict_types=1);

use Illuminate\Contracts\Console\Kernel as ConsoleKernel;
use Symfony\Component\Console\Output\BufferedOutput;

header('Content-Type: text/plain; charset=utf-8');
header('X-Robots-Tag: noindex, nofollow, noarchive');

$expectedTokenHash = '__DEPLOY_TOKEN_HASH__';
$providedToken = (string) ($_GET['token'] ?? '');

if ($providedToken === '' || ! hash_equals($expectedTokenHash, hash('sha256', $providedToken))) {
    http_response_code(403);
    exit("Forbidden\n");
}

$publicPath = __DIR__;
$appRoot = dirname(__DIR__).'/__APP_DIR_NAME__';
$results = [];

$record = static function (string $message) use (&$results): void {
    $results[] = $message;
};

$fail = static function (string $message): never {
    throw new RuntimeException($message);
};

try {
    if (PHP_VERSION_ID < 80300) {
        $fail('PHP 8.3 or newer is required. Current: '.PHP_VERSION);
    }

    foreach ([
        $appRoot,
        $appRoot.'/artisan',
        $appRoot.'/.env',
        $appRoot.'/.public-path',
        $appRoot.'/vendor/autoload.php',
        $appRoot.'/bootstrap/app.php',
        $publicPath.'/build/manifest.json',
    ] as $requiredPath) {
        if (! file_exists($requiredPath)) {
            $fail('Required deployment path is missing: '.$requiredPath);
        }
    }

    $configuredPublicPath = trim((string) file_get_contents($appRoot.'/.public-path'));
    $resolvedConfiguredPublicPath = realpath($appRoot.'/'.$configuredPublicPath);
    $resolvedActualPublicPath = realpath($publicPath);

    if (
        $resolvedConfiguredPublicPath === false ||
        $resolvedActualPublicPath === false ||
        $resolvedConfiguredPublicPath !== $resolvedActualPublicPath
    ) {
        $fail('.public-path does not resolve to the active public_html directory.');
    }

    $writableDirectories = [
        $appRoot.'/bootstrap/cache',
        $appRoot.'/storage/app/private',
        $appRoot.'/storage/app/public',
        $appRoot.'/storage/framework/cache/data',
        $appRoot.'/storage/framework/sessions',
        $appRoot.'/storage/framework/views',
        $appRoot.'/storage/logs',
    ];

    foreach ($writableDirectories as $directory) {
        if (! is_dir($directory) && ! mkdir($directory, 0775, true) && ! is_dir($directory)) {
            $fail('Unable to create writable directory: '.$directory);
        }

        if (! is_writable($directory)) {
            $fail('Directory is not writable by PHP: '.$directory);
        }
    }

    $storageTarget = realpath($appRoot.'/storage/app/public');
    $storageLink = $publicPath.'/storage';

    if ($storageTarget === false) {
        $fail('Public storage target does not exist.');
    }

    if (is_link($storageLink)) {
        if (realpath($storageLink) !== $storageTarget) {
            $fail('An existing storage symlink points to the wrong target.');
        }

        $record('OK: existing public storage symlink is correct.');
    } elseif (file_exists($storageLink)) {
        $fail('public_html/storage already exists and is not a symlink.');
    } else {
        if (! function_exists('symlink')) {
            $fail('symlink() is disabled on this hosting account.');
        }

        if (! @symlink($storageTarget, $storageLink)) {
            $fail('Unable to create public storage symlink.');
        }

        $record('OK: public_html/storage symlink created.');
    }

    require $appRoot.'/vendor/autoload.php';

    $app = require $appRoot.'/bootstrap/app.php';
    $app->usePublicPath($publicPath);
    $kernel = $app->make(ConsoleKernel::class);
    $kernel->bootstrap();

    if (! $app->environment('production')) {
        $fail('APP_ENV must be production before caching configuration.');
    }

    if ((bool) config('app.debug')) {
        $fail('APP_DEBUG must be false before deployment.');
    }

    if ((string) config('app.key') === '') {
        $fail('APP_KEY is empty. Preserve or generate a production key first.');
    }

    try {
        $app->make('db')->connection()->getPdo();
    } catch (Throwable) {
        $fail('Database connection failed. Check the production DB_* values.');
    }

    foreach ([
        'config:clear',
        'route:clear',
        'view:clear',
        'config:cache',
        'route:cache',
        'view:cache',
    ] as $command) {
        $output = new BufferedOutput;
        $exitCode = $kernel->call($command, ['--no-interaction' => true], $output);

        if ($exitCode !== 0) {
            $fail("Artisan command failed: $command");
        }

        $record("OK: php artisan $command");
    }

    $markerPath = $appRoot.'/storage/framework/deploy-complete.json';
    $markerPayload = json_encode([
        'completed_at' => gmdate(DATE_ATOM),
        'php_version' => PHP_VERSION,
        'public_path' => $publicPath,
        'storage_target' => $storageTarget,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);

    if ($markerPayload === false || file_put_contents($markerPath, $markerPayload, LOCK_EX) === false) {
        $fail('Deployment succeeded, but the completion marker could not be written.');
    }

    $selfDeleted = @unlink(__FILE__);

    echo "DEPLOYMENT COMPLETE\n";
    foreach ($results as $result) {
        echo $result."\n";
    }
    echo $selfDeleted
        ? "OK: deploy_once.php deleted itself.\n"
        : "WARNING: delete deploy_once.php manually from public_html.\n";
} catch (Throwable $exception) {
    http_response_code(500);
    echo "DEPLOYMENT FAILED\n";
    echo $exception->getMessage()."\n";
    echo "Fix the reported problem and run this same URL again.\n";
}
